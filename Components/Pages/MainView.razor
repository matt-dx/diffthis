@page "/diff"
@inject DiffSessionService Session
@inject IExportService Export
@inject ISettingsService Settings
@inject AiCacheService AiCache
@inject IAnalysisLinkService LinkService
@inject NavigationManager Nav
@inject IJSRuntime JS
@implements IDisposable

@if (_diff is null)
{
    <div class="page"><p>No diff loaded. <a href="/">Go home</a></p></div>
}
else
{
    <div class="main-view @(Settings.FontLigatures ? "ligatures" : "")">

        <!-- Toolbar -->
        <div class="diff-toolbar">
            <a class="btn btn-sm" title="Repositories" href="/"><span class="icon icon-repo" style="width:16px;height:16px"></span></a>
            <div class="toolbar-title">
                <span class="tname">@_diff.RepositoryName</span>
                <a class="btn btn-sm toolbar-branches-btn" title="Change branches" href="/branches?path=@Uri.EscapeDataString(_diff.RepositoryPath)"><span class="icon icon-branch" style="width:16px;height:16px"></span></a>
                <span class="sep">·</span>
                <code>@_diff.BaseDisplay</code>
                <span class="arrow">→</span>
                <code>@_diff.CompareDisplay</code>
            </div>
            <div class="toolbar-summary">
                <span>@_diff.Files.Count files</span>
                <span class="add">+@_diff.TotalAdditions</span>
                <span class="del">-@_diff.TotalDeletions</span>
            </div>
            <div class="toolbar-actions">
                <button class="btn btn-sm" title="Export Markdown" @onclick="ExportMarkdown"><span class="icon icon-markdown" style="width:16px;height:16px"></span></button>
                <a class="btn btn-sm" title="Settings" href="/settings?from=/diff"><span class="icon icon-gear" style="width:16px;height:16px"></span></a>
            </div>
        </div>

        <!-- Both panels are always mounted — layout is switched purely with CSS classes.
             This preserves in-flight AI runs and all local component state across layout toggles. -->

        @if (!_sideBySide)
        {
            <div class="panel-tabs-bar">
                <button class="panel-tab @(_activeTab == 0 ? "panel-tab-active" : "")"
                        @onclick='() => _activeTab = 0'>Diff</button>
                <button class="panel-tab @(_activeTab == 1 ? "panel-tab-active" : "")"
                        @onclick='() => _activeTab = 1'>Analysis</button>
                <button class="layout-toggle-btn layout-toggle-btn-tabs" title="Switch to side by side" @onclick="ToggleLayout">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="3" y="3" width="18" height="18" rx="2"/>
                        <line x1="12" y1="3" x2="12" y2="21"/>
                    </svg>
                </button>
            </div>
        }

        <div class="@(_sideBySide ? "panels-side-by-side" : "panel-tab-content")">
            <div class="panel-column @(!_sideBySide && _activeTab != 0 ? "panel-hidden" : "")">
                @if (_sideBySide) { <div class="panel-heading">Diff</div> }
                <DiffPanel Diff="_diff"
                           PendingFocus="_pendingFocus"
                           PendingFocusConsumed="OnFocusConsumed"
                           @bind-SidebarCollapsed="_diffSidebarCollapsed" />
            </div>
            <div class="panel-column @(_sideBySide ? "panel-column-border" : "") @(!_sideBySide && _activeTab != 1 ? "panel-hidden" : "")">
                @if (_sideBySide)
                {
                    <div class="panel-heading">
                        Analysis
                        <button class="layout-toggle-btn" title="Switch to tabs" @onclick="ToggleLayout">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <rect x="3" y="3" width="18" height="18" rx="2"/>
                                <line x1="3" y1="9" x2="21" y2="9"/>
                                <line x1="9" y1="9" x2="9" y2="21"/>
                            </svg>
                        </button>
                    </div>
                }
                <AnalysisPanel Diff="_diff"
                               @bind-SidebarCollapsed="_analysisSidebarCollapsed" />
            </div>
        </div>

    </div>
}

@code {
    private DiffResult? _diff;
    private bool _sideBySide;
    private int  _activeTab = 0;
    private bool _diffSidebarCollapsed;
    private bool _analysisSidebarCollapsed;
    private (int fileIndex, int? lineFrom, int? lineTo)? _pendingFocus;

    protected override void OnInitialized()
    {
        LinkService.FocusRequested += OnFocusRequested;
    }

    protected override void OnParametersSet()
    {
        _diff       = Session.CurrentDiff;
        _sideBySide = Settings.MainViewSideBySide;
        if (_diff is null) Nav.NavigateTo("/");
    }

    // Event delegate is Action<> so the subscription must be void; async work lives in the Task overload.
    private void OnFocusRequested(int fileIndex, int? lineFrom, int? lineTo)
        => _ = OnFocusRequestedAsync(fileIndex, lineFrom, lineTo);

    private async Task OnFocusRequestedAsync(int fileIndex, int? lineFrom, int? lineTo)
    {
        if (!_sideBySide && _activeTab != 0)
            _activeTab = 0;
        _pendingFocus = (fileIndex, lineFrom, lineTo);
        await InvokeAsync(StateHasChanged);
    }

    private void OnFocusConsumed()
    {
        _pendingFocus = null;
        // No StateHasChanged needed — DiffPanel already handled it
    }

    public void Dispose() => LinkService.FocusRequested -= OnFocusRequested;

    private void ToggleLayout()
    {
        _sideBySide = !_sideBySide;
        Settings.MainViewSideBySide = _sideBySide;
    }

    private async Task ExportMarkdown()
    {
        if (_diff is null) return;
        var aiResults = AiCache.GetAll(_diff.RepositoryPath, _diff.BaseBranch, _diff.CompareBranch);
        var markdown = Export.GenerateMarkdown(_diff, aiResults);
        var filename = $"diff_{_diff.BaseDisplay}_{_diff.CompareDisplay}_{DateTime.Now:yyyyMMdd_HHmm}.md"
            .Replace('/', '-').Replace('\\', '-')
            .Replace(':', '-').Replace('*', '-').Replace('?', '-')
            .Replace('"', '-').Replace('<', '-').Replace('>', '-').Replace('|', '-');
        using var stream = new MemoryStream(System.Text.Encoding.UTF8.GetBytes(markdown));
        var result = await FileSaver.Default.SaveAsync(filename, stream, CancellationToken.None);
        if (!result.IsSuccessful && result.Exception is not null)
            await JS.InvokeVoidAsync("alert", $"Export failed: {result.Exception.Message}");
    }
}
