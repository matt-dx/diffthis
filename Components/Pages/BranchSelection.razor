@page "/branches"
@inject IGitService GitService
@inject ISettingsService Settings
@inject DiffSessionService Session
@inject NavigationManager Nav

<div class="page narrow">
    <a class="back-link" href="/">← Repositories</a>

    <h1 class="page-h1">Select Branches</h1>
    @if (!string.IsNullOrEmpty(repoName))
    {
        <p class="repo-label">@repoName</p>
    }

    @if (loading)
    {
        <div class="loading">Loading branches…</div>
    }
    else if (!string.IsNullOrEmpty(loadError))
    {
        <div class="error-banner">@loadError</div>
    }
    else
    {
        <div class="branch-picker">

            <!-- Base -->
            <div class="branch-col">
                <label>Base</label>
                <select @bind="baseBranch" @bind:after="OnBaseBranchChanged">
                    @foreach (var b in branches)
                    {
                        <option value="@b">@b</option>
                    }
                </select>
                <label class="commit-pin-label">
                    <input type="checkbox" @bind="pinBase" @bind:after="OnPinBaseChanged" />
                    Specific commit
                </label>
                @if (pinBase)
                {
                    @if (baseCommitsLoading)
                    {
                        <div class="commit-loading">Loading commits…</div>
                    }
                    else
                    {
                        <select class="commit-select" @bind="baseCommit">
                            @foreach (var c in baseCommits)
                            {
                                <option value="@c.Hash">@c.Display</option>
                            }
                        </select>
                    }
                }
            </div>

            <button class="swap-btn" title="Swap branches" @onclick="Swap">⇆</button>

            <!-- Compare -->
            <div class="branch-col">
                <label>Compare</label>
                <select @bind="compareBranch" @bind:after="OnCompareBranchChanged">
                    @foreach (var b in branches)
                    {
                        <option value="@b">@b</option>
                    }
                </select>
                <label class="commit-pin-label">
                    <input type="checkbox" @bind="pinCompare" @bind:after="OnPinCompareChanged" />
                    Specific commit
                </label>
                @if (pinCompare)
                {
                    @if (compareCommitsLoading)
                    {
                        <div class="commit-loading">Loading commits…</div>
                    }
                    else
                    {
                        <select class="commit-select" @bind="compareCommit">
                            @foreach (var c in compareCommits)
                            {
                                <option value="@c.Hash">@c.Display</option>
                            }
                        </select>
                    }
                }
            </div>

        </div>

        @if (!string.IsNullOrEmpty(compareError))
        {
            <div class="error-banner">@compareError</div>
        }

        <button class="btn btn-primary btn-compare"
                disabled="@(!CanCompare || comparing)"
                @onclick="Compare">
            @(comparing ? "Computing diff…" : "Compare →")
        </button>
    }
</div>

@code {
    [SupplyParameterFromQuery(Name = "path")]
    public string? RepoPath { get; set; }

    private string repoName = "";
    private List<string> branches = [];
    private string? baseBranch;
    private string? compareBranch;
    private bool loading = true;
    private bool comparing;
    private string loadError = "";
    private string compareError = "";

    // Commit pinning
    private bool pinBase;
    private bool pinCompare;
    private string? baseCommit;
    private string? compareCommit;
    private List<CommitInfo> baseCommits = [];
    private List<CommitInfo> compareCommits = [];
    private bool baseCommitsLoading;
    private bool compareCommitsLoading;

    private bool CanCompare =>
        !string.IsNullOrEmpty(baseBranch) &&
        !string.IsNullOrEmpty(compareBranch) &&
        baseBranch != compareBranch &&
        !baseCommitsLoading &&
        !compareCommitsLoading;

    protected override async Task OnParametersSetAsync()
    {
        if (string.IsNullOrEmpty(RepoPath)) { loading = false; return; }
        repoName = Path.GetFileName(RepoPath.TrimEnd('/', '\\'));
        loading = true;
        loadError = "";
        try
        {
            branches = await GitService.GetBranchesAsync(RepoPath);

            var saved = Settings.GetBranchState(RepoPath);
            if (saved is not null
                && branches.Contains(saved.BaseBranch)
                && branches.Contains(saved.CompareBranch))
            {
                baseBranch    = saved.BaseBranch;
                compareBranch = saved.CompareBranch;
                pinBase       = saved.PinBase;
                pinCompare    = saved.PinCompare;

                if (pinBase)
                {
                    await LoadBaseCommitsAsync();
                    if (!string.IsNullOrEmpty(saved.BaseCommit)
                        && baseCommits.Any(c => c.Hash == saved.BaseCommit))
                        baseCommit = saved.BaseCommit;
                }
                if (pinCompare)
                {
                    await LoadCompareCommitsAsync();
                    if (!string.IsNullOrEmpty(saved.CompareCommit)
                        && compareCommits.Any(c => c.Hash == saved.CompareCommit))
                        compareCommit = saved.CompareCommit;
                }
            }
            else
            {
                baseBranch    = branches.FirstOrDefault(b => b is "main" or "master") ?? branches.FirstOrDefault();
                compareBranch = branches.Count > 1 ? branches[1] : branches.FirstOrDefault();
            }
        }
        catch (Exception ex) { loadError = ex.Message; }
        finally { loading = false; }
    }

    private async Task OnBaseBranchChanged()
    {
        baseCommit  = null;
        baseCommits = [];
        if (pinBase) await LoadBaseCommitsAsync();
    }

    private async Task OnCompareBranchChanged()
    {
        compareCommit  = null;
        compareCommits = [];
        if (pinCompare) await LoadCompareCommitsAsync();
    }

    private async Task OnPinBaseChanged()
    {
        if (pinBase && baseCommits.Count == 0)
            await LoadBaseCommitsAsync();
    }

    private async Task OnPinCompareChanged()
    {
        if (pinCompare && compareCommits.Count == 0)
            await LoadCompareCommitsAsync();
    }

    private async Task LoadBaseCommitsAsync()
    {
        if (string.IsNullOrEmpty(baseBranch) || string.IsNullOrEmpty(RepoPath)) return;
        baseCommitsLoading = true;
        StateHasChanged();
        try
        {
            baseCommits = await GitService.GetCommitsAsync(RepoPath, baseBranch);
            baseCommit  = baseCommits.FirstOrDefault()?.Hash;
        }
        finally { baseCommitsLoading = false; }
    }

    private async Task LoadCompareCommitsAsync()
    {
        if (string.IsNullOrEmpty(compareBranch) || string.IsNullOrEmpty(RepoPath)) return;
        compareCommitsLoading = true;
        StateHasChanged();
        try
        {
            compareCommits = await GitService.GetCommitsAsync(RepoPath, compareBranch);
            compareCommit  = compareCommits.FirstOrDefault()?.Hash;
        }
        finally { compareCommitsLoading = false; }
    }

    private void Swap()
    {
        (baseBranch,   compareBranch)   = (compareBranch,   baseBranch);
        (pinBase,      pinCompare)      = (pinCompare,      pinBase);
        (baseCommit,   compareCommit)   = (compareCommit,   baseCommit);
        (baseCommits,  compareCommits)  = (compareCommits,  baseCommits);
    }

    private async Task Compare()
    {
        if (!CanCompare || comparing || RepoPath is null) return;
        comparing    = true;
        compareError = "";
        try
        {
            var baseRef    = pinBase    && !string.IsNullOrEmpty(baseCommit)    ? baseCommit!    : baseBranch!;
            var compareRef = pinCompare && !string.IsNullOrEmpty(compareCommit) ? compareCommit! : compareBranch!;

            Session.CurrentDiff = await GitService.GetDiffAsync(RepoPath, baseRef, compareRef);

            // Build display labels — show "branch @ shortHash" when a specific commit is pinned
            Session.CurrentDiff.BaseLabel = pinBase && !string.IsNullOrEmpty(baseCommit)
                ? $"{baseBranch} @ {(baseCommits.FirstOrDefault(c => c.Hash == baseCommit)?.ShortHash ?? baseCommit![..7])}"
                : baseBranch!;
            Session.CurrentDiff.CompareLabel = pinCompare && !string.IsNullOrEmpty(compareCommit)
                ? $"{compareBranch} @ {(compareCommits.FirstOrDefault(c => c.Hash == compareCommit)?.ShortHash ?? compareCommit![..7])}"
                : compareBranch!;

            Settings.SaveBranchState(RepoPath, new BranchSelectionState
            {
                BaseBranch    = baseBranch!,
                CompareBranch = compareBranch!,
                PinBase       = pinBase,
                PinCompare    = pinCompare,
                BaseCommit    = baseCommit    ?? string.Empty,
                CompareCommit = compareCommit ?? string.Empty
            });

            Nav.NavigateTo("/diff");
            return; // leave comparing=true so button stays "Computing diff…" until unmounted
        }
        catch (Exception ex) { compareError = ex.Message; }
        comparing = false;
    }
}
