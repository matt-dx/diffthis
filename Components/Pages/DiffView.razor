@page "/diff"
@inject DiffSessionService Session
@inject IExportService Export
@inject ISettingsService Settings
@inject IClaudeAuthService ClaudeAuth
@inject IClaudeService Claude
@inject AiCacheService AiCache
@inject NavigationManager Nav
@inject IJSRuntime JS
@using Markdig

@if (diff is null)
{
    <div class="page"><p>No diff loaded. <a href="/">Go home</a></p></div>
}
else
{
    <div class="diff-page @(Settings.FontLigatures ? "ligatures" : "")">

        <!-- Toolbar -->
        <div class="diff-toolbar">
            <div class="toolbar-title">
                <span class="tname">@diff.RepositoryName</span>
                <span class="sep">:</span>
                <code>@diff.BaseDisplay</code>
                <span class="arrow">→</span>
                <code>@diff.CompareDisplay</code>
            </div>
            <div class="toolbar-summary">
                <span>@diff.Files.Count files</span>
                <span class="add">+@diff.TotalAdditions</span>
                <span class="del">-@diff.TotalDeletions</span>
            </div>
            <div class="toolbar-actions">
                <a class="btn btn-sm" href="/branches?path=@Uri.EscapeDataString(diff.RepositoryPath)">← Branches</a>
                <a class="btn btn-sm" href="/">← Repositories</a>
                <button class="btn btn-sm" @onclick="ExportMarkdown">Export Markdown</button>
                <a class="btn btn-sm" href="/settings?from=/diff">Settings</a>
            </div>
        </div>

        @if (ClaudeAuth.State == ClaudeAuthState.Authenticated)
        {
            <!-- AI action bar -->
            <div class="ai-action-bar">
                <div class="ai-action-bar-left">
                    <button class="btn btn-sm @(_aiFeature == "review" && _aiPanelOpen ? "btn-active" : "")"
                            @onclick='() => ToggleAiPanel("review")'>Code Review</button>
                    <button class="btn btn-sm @(_aiFeature == "explain" && _aiPanelOpen ? "btn-active" : "")"
                            @onclick='() => ToggleAiPanel("explain")'>Explain Changes</button>
                </div>
                <div class="ai-action-bar-right">
                    <label class="ai-model-label">Model</label>
                    <select class="select-sm" @bind="_selectedModel">
                        @foreach (var m in Claude.AvailableModels)
                        {
                            <option value="@m">@ModelLabel(m)</option>
                        }
                    </select>
                    @if (_aiRunning)
                    {
                        <span class="ai-spinner">Running…</span>
                    }
                    else if (_aiPanelOpen)
                    {
                        <button class="btn btn-sm btn-primary" @onclick="RunAi">Run</button>
                    }
                </div>
            </div>

            <!-- AI panel -->
            @if (_aiPanelOpen)
            {
                var allEntries = AiCache.GetAll(diff!.RepositoryPath, diff.BaseBranch, diff.CompareBranch);
                var featureEntries = allEntries
                    .Where(kv => kv.Key.feature == _aiFeature)
                    .OrderBy(kv => kv.Value.CachedAt)
                    .ToList();
                var viewing = featureEntries.FirstOrDefault(kv => kv.Key.model == _viewingModel);
                if (viewing.Value is null && featureEntries.Count > 0)
                    viewing = featureEntries.Last();
                <div class="ai-panel">
                    @if (_aiError is not null)
                    {
                        <div class="ai-error">@_aiError</div>
                    }
                    @if (_aiRunning)
                    {
                        <div class="ai-loading">
                            Generating response with @ModelLabel(_selectedModel)…
                        </div>
                    }
                    else if (featureEntries.Count == 0)
                    {
                        <div class="ai-empty">
                            Select a model and click <strong>Run</strong> to generate
                            @(_aiFeature == "review" ? "a code review" : "an explanation").
                        </div>
                    }
                    else
                    {
                        <!-- Model tabs -->
                        <div class="ai-model-tabs">
                            @foreach (var (key, entry) in featureEntries)
                            {
                                var capturedModel = key.model;
                                var isActive      = (viewing.Value is not null && viewing.Key.model == capturedModel);
                                <div class="ai-model-tab @(isActive ? "active" : "")">
                                    <button @onclick="() => { _viewingModel = capturedModel; _aiError = null; }">
                                        @ModelLabel(capturedModel)
                                    </button>
                                    <button class="ai-refresh-btn" title="Refresh"
                                            @onclick="() => RefreshModel(capturedModel)">↻</button>
                                </div>
                            }
                        </div>

                        @if (viewing.Value is not null)
                        {
                            <div class="ai-meta">
                                Cached @viewing.Value.CachedAt.ToLocalTime().ToString("MMM d · h:mm tt")
                            </div>
                            <div class="ai-content">
                                @((MarkupString)RenderMarkdown(viewing.Value.Response))
                            </div>
                        }
                    }
                </div>
            }
        }

        <div class="diff-layout">

            <!-- File sidebar -->
            <aside class="file-sidebar">
                <div class="sidebar-heading">Changed Files</div>
                @foreach (var (file, i) in diff.Files.Select((f, i) => (f, i)))
                {
                    var hidden = hiddenFiles.Contains(i);
                    <div class="file-item @(selectedIndex == i ? "active" : "") @(hidden ? "file-hidden" : "")"
                         @onclick="() => ScrollToFile(i)">
                        <span class="status-badge @StatusCss(file.Status)">@StatusLabel(file.Status)</span>
                        <div class="file-info">
                            <span class="file-name">@file.FileName</span>
                            @if (!string.IsNullOrEmpty(file.FileDirectory))
                            {
                                <span class="file-dir">@file.FileDirectory</span>
                            }
                        </div>
                        <div class="file-stats">
                            <span class="add">+@file.Additions</span>
                            <span class="del">-@file.Deletions</span>
                        </div>
                        <button class="eye-btn" title="@(hidden ? "Show file" : "Hide file")"
                                @onclick:stopPropagation
                                @onclick="() => ToggleFile(i)">
                            @if (hidden)
                            {
                                <!-- eye-off -->
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94"/>
                                    <path d="M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19"/>
                                    <path d="M14.12 14.12a3 3 0 1 1-4.24-4.24"/>
                                    <line x1="1" y1="1" x2="23" y2="23"/>
                                </svg>
                            }
                            else
                            {
                                <!-- eye -->
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
                                    <circle cx="12" cy="12" r="3"/>
                                </svg>
                            }
                        </button>
                    </div>
                }
            </aside>

            <!-- Diff content -->
            <div class="diff-content">
                @if (diff.Files.Count == 0)
                {
                    <div class="diff-empty">
                        <p class="diff-empty-title">No differences found</p>
                        <p class="diff-empty-sub">
                            <code>@diff.BaseDisplay</code> and <code>@diff.CompareDisplay</code> are identical.
                        </p>
                        <a class="btn btn-sm" href="/branches?path=@Uri.EscapeDataString(diff.RepositoryPath)">← Change branches</a>
                    </div>
                }
                @foreach (var (file, i) in diff.Files.Select((f, i) => (f, i)))
                {
                    <div class="diff-file @(hiddenFiles.Contains(i) ? "diff-file-hidden" : "")" id="file-@i">
                        <div class="file-header">
                            <span class="status-badge @StatusCss(file.Status)">@StatusLabel(file.Status)</span>
                            <span class="file-path">
                                <span class="dir">@file.FileDirectory</span><strong>@file.FileName</strong>
                            </span>
                            <span class="file-stats ml-auto">
                                <span class="add">+@file.Additions</span>
                                <span class="del">-@file.Deletions</span>
                            </span>
                        </div>

                        @if (file.IsBinary)
                        {
                            <div class="diff-note">Binary file</div>
                        }
                        else if (file.Hunks.Count == 0)
                        {
                            <div class="diff-note">No textual changes</div>
                        }
                        else
                        {
                            var hlLines = _highlighted.TryGetValue(i, out var hl) ? hl : null;
                            var lineIdx = 0;
                            foreach (var hunk in file.Hunks)
                            {
                                <div class="hunk-header">
                                    @($"@@ -{hunk.OldStart},{hunk.OldCount} +{hunk.NewStart},{hunk.NewCount} @@")
                                    @if (!string.IsNullOrEmpty(hunk.Context))
                                    {
                                        <span class="hunk-ctx">@hunk.Context</span>
                                    }
                                </div>
                                <table class="diff-table">
                                    <tbody>
                                        @foreach (var line in hunk.Lines)
                                        {
                                            var capturedIdx = lineIdx;
                                            <tr class="@LineCss(line.Type)">
                                                <td class="ln">@line.OldLineNumber</td>
                                                <td class="ln">@line.NewLineNumber</td>
                                                <td class="sign">@LineSign(line.Type)</td>
                                                <td class="code">
                                                    @if (hlLines != null && capturedIdx < hlLines.Count)
                                                    {
                                                        @((MarkupString)hlLines[capturedIdx])
                                                    }
                                                    else
                                                    {
                                                        @line.Content
                                                    }
                                                </td>
                                            </tr>
                                            lineIdx++;
                                        }
                                    </tbody>
                                </table>
                            }
                        }
                    </div>
                }
            </div>

        </div>
    </div>
}

@code {
    private DiffResult? diff;
    private int selectedIndex = -1;
    private HashSet<int> hiddenFiles = [];
    private Dictionary<int, List<string>> _highlighted = [];
    private bool _highlighting;

    // ── AI panel state ────────────────────────────────────────────────────
    private bool    _aiPanelOpen  = false;
    private string  _aiFeature    = "review";
    private string  _selectedModel = "claude-sonnet-4-6";
    private string? _viewingModel;
    private bool    _aiRunning    = false;
    private string? _aiError;

    protected override void OnParametersSet()
    {
        diff = Session.CurrentDiff;
        selectedIndex = -1;
        hiddenFiles.Clear();
        _highlighted.Clear();
        _highlighting = diff is not null;
        _aiPanelOpen  = false;
        _aiFeature    = "review";
        _viewingModel = null;
        _aiError      = null;
        _aiRunning    = false;
        if (diff is null) Nav.NavigateTo("/");
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_highlighting) return;
        _highlighting = false;
        try
        {
            await Task.Run(ComputeHighlighting);
        }
        catch { /* silently ignore; _highlighted will have whatever partial results were saved */ }
        await InvokeAsync(StateHasChanged);
    }

    private void ComputeHighlighting()
    {
        if (diff is null) return;
        foreach (var (file, fi) in diff.Files.Select((f, i) => (f, i)))
        {
            if (file.IsBinary || file.Hunks.Count == 0) continue;
            var lang = SyntaxHighlighter.GetLanguage(file.FileName);
            if (lang is null) continue;

            try
            {
                var lines = new List<string>();
                foreach (var hunk in file.Hunks)
                {
                    var contents = hunk.Lines.Select(l => l.Content).ToArray();
                    lines.AddRange(SyntaxHighlighter.HighlightLines(contents, lang));
                }
                _highlighted[fi] = lines;
            }
            catch { /* skip this file; it will render as plain text */ }
        }
    }

    private async Task ScrollToFile(int index)
    {
        hiddenFiles.Remove(index); // clicking a hidden file un-hides it
        selectedIndex = index;
        await JS.InvokeVoidAsync("scrollToElement", $"file-{index}");
    }

    private void ToggleFile(int index)
    {
        if (!hiddenFiles.Remove(index))
            hiddenFiles.Add(index);
    }

    // ── AI actions ────────────────────────────────────────────────────────

    private void ToggleAiPanel(string feature)
    {
        if (_aiFeature == feature && _aiPanelOpen)
        {
            _aiPanelOpen = false;
        }
        else
        {
            _aiFeature   = feature;
            _aiPanelOpen = true;
            // Pick best model tab to show initially
            if (diff is not null)
            {
                var cached = AiCache.GetAll(diff.RepositoryPath, diff.BaseBranch, diff.CompareBranch)
                    .Where(kv => kv.Key.feature == feature)
                    .OrderByDescending(kv => kv.Value.CachedAt)
                    .FirstOrDefault();
                _viewingModel = cached.Value is not null ? cached.Key.model : null;
            }
            _aiError = null;
        }
    }

    private async Task RunAi()
    {
        if (diff is null || _aiRunning) return;
        await RunAiInner(_aiFeature, _selectedModel, refresh: false);
    }

    private async Task RefreshModel(string model)
    {
        if (diff is null || _aiRunning) return;
        AiCache.Remove(diff.RepositoryPath, diff.BaseBranch, diff.CompareBranch, _aiFeature, model);
        await RunAiInner(_aiFeature, model, refresh: true);
    }

    private async Task RunAiInner(string feature, string model, bool refresh)
    {
        _aiRunning    = true;
        _aiError      = null;
        _viewingModel = model;
        StateHasChanged();

        try
        {
            var result = feature == "review"
                ? await Claude.ReviewDiffAsync(diff!, model)
                : await Claude.ExplainDiffAsync(diff!, model);

            AiCache.Set(diff!.RepositoryPath, diff.BaseBranch, diff.CompareBranch, feature, model, result);
        }
        catch (UnauthorizedAccessException ex)
        {
            _aiError = ex.Message;
            ClaudeAuth.Reload();
        }
        catch (Exception ex)
        {
            _aiError = $"Request failed: {ex.Message}";
        }
        finally
        {
            _aiRunning = false;
            StateHasChanged();
        }
    }

    private static string RenderMarkdown(string markdown)
    {
        var pipeline = new MarkdownPipelineBuilder().UseAdvancedExtensions().Build();
        return Markdown.ToHtml(markdown, pipeline);
    }

    private static string ModelLabel(string model) => model switch
    {
        "claude-opus-4-8"          => "Opus 4.8",
        "claude-sonnet-4-6"        => "Sonnet 4.6",
        "claude-haiku-4-5-20251001"=> "Haiku 4.5",
        _                          => model,
    };

    // ── Export ────────────────────────────────────────────────────────────

    private async Task ExportMarkdown()
    {
        if (diff is null) return;
        var path = ExportPath("md");
        await Export.ExportMarkdownAsync(diff, path);
        await JS.InvokeVoidAsync("alert", $"Saved to:\n{path}");
    }

    private string ExportPath(string ext)
    {
        var name = $"diff_{diff!.BaseDisplay}_{diff.CompareDisplay}_{DateTime.Now:yyyyMMdd_HHmm}.{ext}"
            .Replace('/', '-').Replace('\\', '-');
        return Path.Combine(Environment.GetFolderPath(Environment.SpecialFolder.Desktop), name);
    }

    private static string LineCss(DiffLineType t) => t switch
    {
        DiffLineType.Addition => "add-line",
        DiffLineType.Deletion => "del-line",
        _                     => "ctx-line"
    };

    private static string LineSign(DiffLineType t) => t switch
    {
        DiffLineType.Addition => "+",
        DiffLineType.Deletion => "-",
        _                     => " "
    };

    private static string StatusCss(DiffFileStatus s) => s switch
    {
        DiffFileStatus.Added    => "badge-added",
        DiffFileStatus.Deleted  => "badge-deleted",
        DiffFileStatus.Renamed  => "badge-renamed",
        DiffFileStatus.Copied   => "badge-copied",
        _                       => "badge-modified"
    };

    private static string StatusLabel(DiffFileStatus s) => s switch
    {
        DiffFileStatus.Added    => "A",
        DiffFileStatus.Deleted  => "D",
        DiffFileStatus.Renamed  => "R",
        DiffFileStatus.Copied   => "C",
        _                       => "M"
    };
}
