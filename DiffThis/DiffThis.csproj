<Project Sdk="Microsoft.NET.Sdk.Razor">
  <!-- Run unpackaged in Debug so F5 works without deploying an MSIX.
       Release builds produce an MSIX package for the Microsoft Store
       (the self-contained-exe release pipeline overrides this with
       -p:WindowsPackageType=None). -->
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <WindowsPackageType>None</WindowsPackageType>
  </PropertyGroup>
  <PropertyGroup>
    <TargetFrameworks>net10.0-windows10.0.19041.0</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <RootNamespace>DiffThis</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableDefaultCssItems>false</EnableDefaultCssItems>
    <Nullable>enable</Nullable>
    <ApplicationTitle>DiffThis</ApplicationTitle>
    <!-- App identity (Windows / MSIX Store). The Identity Name and Publisher
         here must match Platforms\Windows\Package.appxmanifest and the values
         reserved for the app in Partner Center. -->
    <ApplicationId>MattWhitwam.DiffThis</ApplicationId>
    <ApplicationPublisher>CN=285A97EB-1786-4EB8-87B3-CBF3A5260DF7</ApplicationPublisher>
    <!-- Versions. ApplicationDisplayVersion is overwritten by the release
         pipeline. ApplicationVersion must stay 0 on Windows: it becomes the
         4th (revision) component of the MSIX package version, and the Store
         rejects any package whose revision is non-zero. -->
    <ApplicationVersion>0</ApplicationVersion>
    <ApplicationDisplayVersion>1.8.0</ApplicationDisplayVersion>
    <Platforms>Windows</Platforms>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
  </PropertyGroup>
  <!-- Self-contained exe settings. Kept here so they do NOT propagate to
       referenced library projects via global -p: flags. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release' AND '$(WindowsPackageType)' == 'None'">
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
  </PropertyGroup>
  <!-- MSIX Store packaging settings. Kept in the app project (not passed via
       global -p: flags) so they do NOT propagate to the referenced MAUI
       library projects, which would otherwise try to build their own appx. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release' AND '$(WindowsPackageType)' != 'None'">
    <GenerateAppxPackageOnBuild>true</GenerateAppxPackageOnBuild>
    <AppxPackageSigningEnabled>false</AppxPackageSigningEnabled>
    <UapAppxPackageBuildMode>StoreUpload</UapAppxPackageBuildMode>
    <AppxSymbolPackageEnabled>false</AppxSymbolPackageEnabled>
  </PropertyGroup>
  <ItemGroup>
    <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#1E1E2E" />
    <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#1E1E2E" BaseSize="128,128" />
    <MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="10.*" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebView.Maui" Version="10.*" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.*" />
    <PackageReference Include="CommunityToolkit.Maui" Version="13.0.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\DiffThis.UI\DiffThis.UI.csproj" />
    <ProjectReference Include="..\DiffThis.Core\DiffThis.Core.csproj" />
    <ProjectReference Include="..\DiffThis.AI.Shared\DiffThis.AI.Shared.csproj" />
    <ProjectReference Include="..\DiffThis.AI.Claude\DiffThis.AI.Claude.csproj" />
    <ProjectReference Include="..\DiffThis.AI.OpenAI\DiffThis.AI.OpenAI.csproj" />
  </ItemGroup>
</Project>