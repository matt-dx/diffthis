@inject ISettingsService Settings
@inject IAnalysisLinkService LinkService
@inject IClaudeModelService ModelService
@inject DiffSessionService Session
@inject IJSRuntime JS
@implements IDisposable

@if (Diff is not null)
{
    <div class="diff-layout" @onclick="CloseContextMenu">

        <!-- File sidebar -->
        <aside class="file-sidebar @(SidebarCollapsed ? "sidebar-collapsed" : "")">
            <div class="sidebar-toggle">
                <button class="sidebar-toggle-btn"
                        title="@(SidebarCollapsed ? "Expand sidebar" : "Collapse sidebar")"
                        aria-label="@(SidebarCollapsed ? "Expand sidebar" : "Collapse sidebar")"
                        aria-expanded="@(SidebarCollapsed ? "false" : "true")"
                        @onclick:stopPropagation @onclick="() => SidebarCollapsedChanged.InvokeAsync(!SidebarCollapsed)">
                    <span class="icon @(SidebarCollapsed ? "icon-chevron-bar-right" : "icon-chevron-bar-left")" style="width:16px;height:16px"></span>
                </button>
            </div>
            <div class="sidebar-heading">
                <span>Changed Files</span>
                <div class="file-stats">
                    <span class="add">+@Diff.TotalAdditions</span>
                    <span class="del">-@Diff.TotalDeletions</span>
                </div>
            </div>
            @foreach (var (file, i) in Diff.Files.Select((f, i) => (f, i)))
            {
                var hidden = Session.HiddenFiles.Contains(i);
                <div class="file-item @(_selectedIndex == i ? "active" : "") @(hidden ? "file-hidden" : "")"
                     @onclick="() => ScrollToFile(i)">
                    <span class="status-badge @StatusCss(file.Status)">@StatusLabel(file.Status)</span>
                    <div class="file-info">
                        <span class="file-name">@file.FileName</span>
                        @if (!string.IsNullOrEmpty(file.FileDirectory))
                        {
                            <span class="file-dir">@file.FileDirectory</span>
                        }
                    </div>
                    <div class="file-stats">
                        <span class="add">+@file.Additions</span>
                        <span class="del">-@file.Deletions</span>
                    </div>
                    <button class="eye-btn" title="@(hidden ? "Show file" : "Hide file")"
                            @onclick:stopPropagation
                            @onclick="() => ToggleFile(i)">
                        <span class="icon @(hidden ? "icon-eye-off" : "icon-eye")"></span>
                    </button>
                </div>
            }
        </aside>

        <!-- Diff content -->
        <div class="diff-content" style="position:relative">
            @if (Diff.Files.Count == 0)
            {
                <div class="diff-empty">
                    <p class="diff-empty-title">No differences found</p>
                    <p class="diff-empty-sub">
                        <code>@Diff.BaseDisplay</code> and <code>@Diff.CompareDisplay</code> are identical.
                    </p>
                    <a class="btn btn-sm" href="/branches?path=@Uri.EscapeDataString(Diff.RepositoryPath)">← Change branches</a>
                </div>
            }
            @foreach (var (file, fi) in Diff.Files.Select((f, i) => (f, i)))
            {
                var fileRefs = Settings.AnalysisLinksEnabled ? LinkService.GetFileRefs(fi) : (IReadOnlyList<AnalysisRef>)[];
                <div class="diff-file @(Session.HiddenFiles.Contains(fi) ? "diff-file-hidden" : "")" id="file-@fi">
                    <div class="file-header">
                        <span class="status-badge @StatusCss(file.Status)">@StatusLabel(file.Status)</span>
                        <span class="file-path">
                            <span class="dir">@file.FileDirectory</span><strong>@file.FileName</strong>
                        </span>
                        <span class="file-stats ml-auto">
                            <span class="add">+@file.Additions</span>
                            <span class="del">-@file.Deletions</span>
                        </span>
                        @if (fileRefs.Count > 0)
                        {
                            <!-- Show one icon per unique Category across all visible refs for this file -->
                            <div class="file-header-refs">
                                @foreach (var r in fileRefs.GroupBy(r => r.Category).Select(g => g.First()))
                                {
                                    var capturedR = r;
                                    <span class="@RefIconClass(r.Category) ref-icon file-ref-icon @SeverityCss(r.Severity)"
                                          title="@RefTooltip(r)"
                                          @onclick="e => OpenContextMenu(fileRefs.ToList(), e)"
                                          @onclick:stopPropagation></span>
                                }
                            </div>
                        }
                    </div>

                    @if (file.IsBinary)
                    {
                        <div class="diff-note">Binary file</div>
                    }
                    else if (file.Hunks.Count == 0)
                    {
                        <div class="diff-note">No textual changes</div>
                    }
                    else
                    {
                        var hlLines = _highlighted.TryGetValue(fi, out var hl) ? hl : null;
                        var lineIdx = 0;
                        foreach (var hunk in file.Hunks)
                        {
                            <div class="hunk-header">
                                @($"@@ -{hunk.OldStart},{hunk.OldCount} +{hunk.NewStart},{hunk.NewCount} @@")
                                @if (!string.IsNullOrEmpty(hunk.Context))
                                {
                                    <span class="hunk-ctx">@hunk.Context</span>
                                }
                            </div>
                            <table class="diff-table">
                                <tbody>
                                    @foreach (var line in hunk.Lines)
                                    {
                                        var capturedIdx = lineIdx;
                                        var lineRefs    = (Settings.AnalysisLinksEnabled && line.NewLineNumber.HasValue)
                                            ? LinkService.GetLineRefs(fi, line.NewLineNumber.Value)
                                            : (IReadOnlyList<AnalysisRef>)[];
                                        var rowId = line.NewLineNumber.HasValue
                                            ? $"diff-{fi}-{line.NewLineNumber.Value}"
                                            : null;
                                        <tr class="@LineCss(line.Type)" id="@rowId">
                                            <td class="ref-col" @onclick:stopPropagation>
                                                @if (lineRefs.Count == 1)
                                                {
                                                    var r = lineRefs[0];
                                                    <span class="@RefIconClass(r.Category) ref-icon @SeverityCss(r.Severity)"
                                                          title="@RefTooltip(r)"
                                                          @onclick="() => NavigateToRef(r)"></span>
                                                }
                                                else if (lineRefs.Count > 1)
                                                {
                                                    var capturedRefs = lineRefs.ToList();
                                                    <span class="icon icon-ref-multi ref-icon"
                                                          title="@lineRefs.Count analysis references"
                                                          @onclick="e => OpenContextMenu(capturedRefs, e)"></span>
                                                }
                                            </td>
                                            <td class="ln">@line.OldLineNumber</td>
                                            <td class="ln">@line.NewLineNumber</td>
                                            <td class="sign">@LineSign(line.Type)</td>
                                            <td class="code">
                                                @if (hlLines != null && capturedIdx < hlLines.Count)
                                                {
                                                    @((MarkupString)hlLines[capturedIdx])
                                                }
                                                else
                                                {
                                                    @line.Content
                                                }
                                            </td>
                                        </tr>
                                        lineIdx++;
                                    }
                                </tbody>
                            </table>
                        }
                    }
                </div>
            }

            <!-- Context menu for multiple refs on one line -->
            @if (_menuRefs is not null)
            {
                <div class="ref-context-menu" style="position:fixed;top:@(_menuY)px;left:@(_menuX)px"
                     @onclick:stopPropagation>
                    @foreach (var r in _menuRefs)
                    {
                        var capturedR = r;
                        <div class="ref-context-item" @onclick="() => { NavigateToRef(capturedR); CloseContextMenu(); }">
                            <span class="@RefIconClass(r.Category) ref-icon @SeverityCss(r.Severity)"></span>
                            <span>@RefTooltip(r)</span>
                        </div>
                    }
                </div>
            }
        </div>

    </div>
}

@code {
    [Parameter] public DiffResult? Diff { get; set; }
    [Parameter] public (int fileIndex, int? lineFrom, int? lineTo)? PendingFocus { get; set; }
    [Parameter] public EventCallback PendingFocusConsumed { get; set; }

    [Parameter] public bool SidebarCollapsed { get; set; }
    [Parameter] public EventCallback<bool> SidebarCollapsedChanged { get; set; }

    private int _selectedIndex = -1;
    private Dictionary<int, List<string>> _highlighted = [];
    private bool _highlighting;
    private DiffResult? _lastDiff;
    private (int fileIndex, int? lineFrom, int? lineTo)? _lastFocus;

    // Context menu state
    private List<AnalysisRef>? _menuRefs;
    private double _menuX, _menuY;

    protected override void OnInitialized() =>
        LinkService.Changed += OnLinksChanged;

    protected override void OnParametersSet()
    {
        if (_lastDiff != Diff)
        {
            _lastDiff = Diff;
            _selectedIndex = -1;
            Session.ResetDiffState();
            _highlighted.Clear();
            _highlighting = Diff is not null;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Handle syntax highlighting trigger
        if (_highlighting)
        {
            _highlighting = false;
            try { await Task.Run(ComputeHighlighting); }
            catch { /* partial results are fine */ }
            await InvokeAsync(StateHasChanged);
        }

        // Handle pending focus from AnalysisPanel link click
        if (PendingFocus.HasValue && PendingFocus != _lastFocus)
        {
            _lastFocus = PendingFocus;
            var (fileIdx, lineFrom, _) = PendingFocus.Value;
            string targetId;
            if (lineFrom.HasValue && fileIdx >= 0)
                targetId = $"diff-{fileIdx}-{lineFrom.Value}";
            else if (fileIdx >= 0)
                targetId = $"file-{fileIdx}";
            else
                targetId = null!;

            if (targetId is not null)
            {
                Session.HiddenFiles.Remove(fileIdx);
                _selectedIndex = fileIdx;
                // Fall back to the file header if the specific line isn't in the diff hunk
                await JS.InvokeVoidAsync("scrollToElement", targetId, $"file-{fileIdx}");
            }
            await PendingFocusConsumed.InvokeAsync();
        }
    }

    private void OnLinksChanged() => InvokeAsync(StateHasChanged);
    public void Dispose() => LinkService.Changed -= OnLinksChanged;

    private void NavigateToRef(AnalysisRef r)
    {
        if (Diff is null) return;
        LinkService.RequestFocus(
            r.LineFrom.HasValue ? $"{r.FilePath}:{r.LineFrom}" : r.FilePath,
            Diff);
    }

    private void OpenContextMenu(List<AnalysisRef> refs, MouseEventArgs e)
    {
        _menuRefs = refs;
        _menuX    = e.ClientX;
        _menuY    = e.ClientY;
    }

    private void CloseContextMenu() => _menuRefs = null;

    private void ComputeHighlighting()
    {
        if (Diff is null) return;
        foreach (var (file, fi) in Diff.Files.Select((f, i) => (f, i)))
        {
            if (file.IsBinary || file.Hunks.Count == 0) continue;
            var lang = SyntaxHighlighter.GetLanguage(file.FileName);
            if (lang is null) continue;
            try
            {
                var lines = new List<string>();
                foreach (var hunk in file.Hunks)
                {
                    var contents = hunk.Lines.Select(l => l.Content).ToArray();
                    lines.AddRange(SyntaxHighlighter.HighlightLines(contents, lang));
                }
                _highlighted[fi] = lines;
            }
            catch { /* skip file; renders as plain text */ }
        }
    }

    private async Task ScrollToFile(int index)
    {
        Session.HiddenFiles.Remove(index);
        _selectedIndex = index;
        await JS.InvokeVoidAsync("scrollToElement", $"file-{index}");
    }

    private void ToggleFile(int index)
    {
        if (!Session.HiddenFiles.Remove(index))
            Session.HiddenFiles.Add(index);
    }

    private static string RefIconClass(RefCategory c) => c switch
    {
        RefCategory.Bug        => "icon icon-ref-bug",
        RefCategory.LogicError => "icon icon-ref-knight",
        RefCategory.Security   => "icon icon-ref-shield-cracked",
        _                      => "icon icon-ref-bubble",
    };

    private static string SeverityCss(RefSeverity s) => s switch
    {
        RefSeverity.Critical => "severity-critical",
        RefSeverity.High     => "severity-high",
        RefSeverity.Medium   => "severity-medium",
        RefSeverity.Low      => "severity-low",
        _                    => "",
    };

    private string RefTooltip(AnalysisRef r)
    {
        var model = ModelService.GetDisplayName(r.RunKey.Model);
        var sev   = r.Severity != RefSeverity.Unknown ? $" · {r.Severity.ToString().ToLower()}" : "";
        return $"{model}{sev}";
    }

    private static string LineCss(DiffLineType t) => t switch
    {
        DiffLineType.Addition => "add-line",
        DiffLineType.Deletion => "del-line",
        _                     => "ctx-line"
    };

    private static string LineSign(DiffLineType t) => t switch
    {
        DiffLineType.Addition => "+",
        DiffLineType.Deletion => "-",
        _                     => " "
    };

    private static string StatusCss(DiffFileStatus s) => s switch
    {
        DiffFileStatus.Added    => "badge-added",
        DiffFileStatus.Deleted  => "badge-deleted",
        DiffFileStatus.Renamed  => "badge-renamed",
        DiffFileStatus.Copied   => "badge-copied",
        _                       => "badge-modified"
    };

    private static string StatusLabel(DiffFileStatus s) => s switch
    {
        DiffFileStatus.Added    => "A",
        DiffFileStatus.Deleted  => "D",
        DiffFileStatus.Renamed  => "R",
        DiffFileStatus.Copied   => "C",
        _                       => "M"
    };
}
