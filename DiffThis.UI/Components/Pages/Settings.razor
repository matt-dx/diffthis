@page "/settings"
@inject ISettingsService Svc
@inject ILogService LogSvc
@inject IClaudeAuthService ClaudeAuth
@inject IClaudeModelService ModelService
@inject ICopilotAuthService CopilotAuth
@inject ICopilotModelService CopilotModelService
@inject IGitHubAuthService GitHubAuth
@inject IGitLabAuthService GitLabAuth
@inject IBitbucketAuthService BitbucketAuth
@inject IAzureDevOpsAuthService AzureDevOpsAuth
@inject IGitHostService GitHosts
@inject IOpenAiAuthService OpenAiAuth
@inject IOpenAiModelService OpenAiModelService
@inject IOllamaEndpointService OllamaEndpoints
@inject AiCacheService AiCache
@implements IDisposable
@using DiffThis.UI.Data

<div class="settings-view">
<div class="settings-header">
    <a class="back-link" href="@_returnUrl">← Back</a>
    <span class="settings-header-title">Settings</span>
</div>
<div class="settings-body">
<div class="page narrow">

    <div class="mode-toggle">
        <button class="btn btn-sm @(_activeTab == SettingsTab.General ? "btn-active" : "")" @onclick="() => _activeTab = SettingsTab.General">General</button>
        <button class="btn btn-sm @(_activeTab == SettingsTab.AiIntegration ? "btn-active" : "")" @onclick="() => _activeTab = SettingsTab.AiIntegration">AI Integration</button>
        <button class="btn btn-sm @(_activeTab == SettingsTab.SourceControl ? "btn-active" : "")" @onclick="() => _activeTab = SettingsTab.SourceControl">Source Control</button>
    </div>

    @if (_activeTab == SettingsTab.General)
    {
    <section class="settings-section">
        <p class="section-title">Appearance</p>
        <div class="setting-card">
            <label class="setting-label">Theme</label>
            <div class="theme-selector">
                <button class="theme-btn @Active(AppTheme.Unspecified)"
                        @onclick='() => SetTheme(AppTheme.Unspecified)'>System</button>
                <button class="theme-btn @Active(AppTheme.Light)"
                        @onclick='() => SetTheme(AppTheme.Light)'>&#x2600; Light</button>
                <button class="theme-btn @Active(AppTheme.Dark)"
                        @onclick='() => SetTheme(AppTheme.Dark)'>&#x1F319; Dark</button>
            </div>
        </div>
        <div class="setting-card">
            <div class="setting-row">
                <div>
                    <p class="setting-label">Font ligatures</p>
                    <p class="setting-desc">Render <code>!=</code>, <code>=></code>, and similar sequences as typographic symbols in diffs</p>
                </div>
                <label class="toggle">
                    <input type="checkbox" @bind="fontLigatures" @bind:after="SaveFontLigatures" />
                    <span class="toggle-track"></span>
                </label>
            </div>
        </div>
    </section>
    }

    @if (_activeTab == SettingsTab.AiIntegration)
    {
    <section class="settings-section">
        <p class="section-title"><span class="icon icon-claude" style="width:2em;height:2em;vertical-align:-0.4em;margin-right:0.35em;color:#e07b39"></span>Claude AI</p>
        <div class="setting-card">
            <div class="setting-row">
                <div>
                    <p class="setting-label">Account</p>
                    @if (ClaudeAuth.State == ClaudeAuthState.Authenticated)
                    {
                        <p class="setting-desc">
                            <span class="auth-dot auth-ok"></span>
                            Connected
                            @if (!string.IsNullOrEmpty(ClaudeAuth.Email))
                            {
                                <span> · @ClaudeAuth.Email</span>
                            }
                            @if (!string.IsNullOrEmpty(ClaudeAuth.SubscriptionType))
                            {
                                <span class="auth-plan">(@ClaudeAuth.SubscriptionType)</span>
                            }
                        </p>
                        <p class="setting-desc">To sign out, run <code>claude auth logout</code> in your terminal.</p>
                    }
                    else
                    {
                        <p class="setting-desc">
                            <span class="auth-dot auth-off"></span>
                            Not connected — install Claude Code and run <code>claude auth login</code>, then click Reload below.
                        </p>
                    }
                </div>
                <button class="btn btn-sm" @onclick="ReloadAuth">Reload</button>
            </div>
            <hr class="setting-card-divider" />
            <div class="setting-row">
                <div>
                    <button class="collapsible-label" @onclick="() => _modelsExpanded = !_modelsExpanded">
                        <span class="collapsible-chevron @(_modelsExpanded ? "open" : "")">›</span>
                        <p class="setting-label" style="display:inline">Available models</p>
                    </button>
                    <p class="setting-desc">
                        @if (ModelService.LastFetchedAt.HasValue)
                        {
                            <span>@ModelService.Models.Count model@(ModelService.Models.Count == 1 ? "" : "s") · last updated @ModelService.LastFetchedAt.Value.ToLocalTime().ToString("MMM d · h:mm tt")</span>
                        }
                        else { <span>Never fetched</span> }
                    </p>
                </div>
                <button class="btn btn-sm" disabled="@ModelService.IsLoading" @onclick="RefreshModels">
                    @(ModelService.IsLoading ? "Refreshing…" : "Refresh")
                </button>
            </div>
            @if (_modelsExpanded && ModelService.Models.Count > 0)
            {
                <div class="model-list">
                    @foreach (var model in ModelService.Models)
                    {
                        var capturedId = model.Id;
                        <div class="model-list-item @(model.IsHidden ? "model-hidden" : "")">
                            <div class="model-list-main-row">
                                <div class="model-list-meta"><code class="model-list-id">@model.Id</code></div>
                                <div class="model-list-name-row">
                                    <input class="model-name-input" value="@model.DisplayName"
                                           @onchange="e => ModelService.SetDisplayName(capturedId, e.Value?.ToString() ?? model.DisplayName)"
                                           title="Edit display name" />
                                    @if (model.IsCustomName)
                                    {
                                        <button class="model-reset-btn" title="Reset to default name"
                                                @onclick="() => ModelService.ResetDisplayName(capturedId)">↺</button>
                                    }
                                    <button class="model-visibility-btn @(model.IsHidden ? "hidden" : "")"
                                            title="@(model.IsHidden ? "Show in model dropdowns" : "Hide from model dropdowns")"
                                            @onclick="() => ModelService.ToggleHidden(capturedId)">
                                        <span class="icon @(model.IsHidden ? "icon-eye-off" : "icon-eye")" style="width:14px;height:14px;"></span>
                                    </button>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
        <div class="setting-card">
            <div class="setting-row">
                <div>
                    <p class="setting-label">Tool use</p>
                    <p class="setting-desc">Allow Claude to read files and run commands when reviewing. Produces richer results but uses more turns.</p>
                </div>
                <label class="toggle">
                    <input type="checkbox" @bind="aiToolsEnabled" @bind:after="SaveAiTools" />
                    <span class="toggle-track"></span>
                </label>
            </div>
            @if (aiToolsEnabled)
            {
            <div class="setting-row" style="margin-top:12px">
                <div>
                    <p class="setting-label">Max turns</p>
                    <p class="setting-desc">Maximum agentic turns per request. Higher values allow deeper analysis; 0 means unlimited.</p>
                </div>
                <select class="select-sm" @bind="aiMaxTurns" @bind:after="SaveAiMaxTurns">
                    <option value="1">1 turn</option>
                    <option value="3">3 turns</option>
                    <option value="5">5 turns</option>
                    <option value="10">10 turns</option>
                    <option value="20">20 turns</option>
                    <option value="0">Unlimited</option>
                </select>
            </div>
            }
        </div>
    </section>

    <section class="settings-section">
        <p class="section-title"><span class="icon icon-openai" style="width:2em;height:2em;vertical-align:-0.4em;margin-right:0.35em;color:#10A37F"></span>OpenAI</p>
        <div class="setting-card">
            <div class="setting-row">
                <div>
                    <p class="setting-label">Account</p>
                    @if (OpenAiAuth.State == OpenAiAuthState.Authenticated)
                    {
                        <p class="setting-desc">
                            <span class="auth-dot auth-ok"></span>
                            @(OpenAiAuth.StatusText ?? "Connected with ChatGPT")
                        </p>
                        <p class="setting-desc">Authentication and token refresh are managed by the official Codex CLI. DiffThis does not store an API key.</p>
                    }
                    else if (OpenAiAuth.State == OpenAiAuthState.CliNotFound)
                    {
                        <p class="setting-desc"><span class="auth-dot auth-off"></span>Codex CLI not found — install <code>@@openai/codex</code>, then sign in.</p>
                    }
                    else
                    {
                        <p class="setting-desc"><span class="auth-dot auth-off"></span>Not connected — sign in online with your ChatGPT account.</p>
                    }
                    @if (!string.IsNullOrWhiteSpace(OpenAiAuth.LastError))
                    {
                        <p class="setting-desc" style="color:var(--del-fg);margin-top:4px;word-break:break-word">@OpenAiAuth.LastError</p>
                    }
                </div>
                <div style="display:flex;flex-direction:column;gap:6px;align-items:flex-end">
                    @if (OpenAiAuth.State == OpenAiAuthState.Authenticated)
                    {
                        <button class="btn btn-sm" disabled="@_openAiBusy" @onclick="RefreshOpenAiAuth">Reload</button>
                        <button class="btn btn-sm btn-danger" disabled="@_openAiBusy" @onclick="OpenAiSignOut">Sign out</button>
                    }
                    else
                    {
                        <button class="btn btn-sm" disabled="@(_openAiBusy || OpenAiAuth.State == OpenAiAuthState.CliNotFound)" @onclick="StartOpenAiSignIn">
                            @(_openAiBusy ? "Signing in…" : "Sign in with ChatGPT")
                        </button>
                        <button class="btn btn-sm" disabled="@_openAiBusy" @onclick="RefreshOpenAiAuth">Reload</button>
                    }
                </div>
            </div>
            <hr class="setting-card-divider" />
            <div class="setting-row">
                <div>
                    <button class="collapsible-label" @onclick="() => _openAiModelsExpanded = !_openAiModelsExpanded">
                        <span class="collapsible-chevron @(_openAiModelsExpanded ? "open" : "")">›</span>
                        <p class="setting-label" style="display:inline">Available models</p>
                    </button>
                    <p class="setting-desc">
                        @if (OpenAiModelService.LastFetchedAt.HasValue)
                        {
                            <span>@OpenAiModelService.Models.Count model@(OpenAiModelService.Models.Count == 1 ? "" : "s") · last updated @OpenAiModelService.LastFetchedAt.Value.ToLocalTime().ToString("MMM d · h:mm tt")</span>
                        }
                        else { <span>Codex default (refresh to load the CLI catalog)</span> }
                    </p>
                </div>
                <button class="btn btn-sm" disabled="@(OpenAiModelService.IsLoading || OpenAiAuth.State != OpenAiAuthState.Authenticated)" @onclick="RefreshOpenAiModels">
                    @(OpenAiModelService.IsLoading ? "Refreshing…" : "Refresh")
                </button>
            </div>
            @if (_openAiModelsExpanded && OpenAiModelService.Models.Count > 0)
            {
                <div class="model-list">
                    @foreach (var model in OpenAiModelService.Models)
                    {
                        var capturedId = model.Id;
                        <div class="model-list-item @(model.IsHidden ? "model-hidden" : "")">
                            <div class="model-list-main-row">
                                <div class="model-list-meta"><code class="model-list-id">@model.Id</code></div>
                                <div class="model-list-name-row">
                                    <input class="model-name-input" value="@model.DisplayName"
                                           @onchange="e => OpenAiModelService.SetDisplayName(capturedId, e.Value?.ToString() ?? model.DisplayName)"
                                           title="Edit display name" />
                                    @if (model.IsCustomName)
                                    {
                                        <button class="model-reset-btn" title="Reset to default name" @onclick="() => OpenAiModelService.ResetDisplayName(capturedId)">↺</button>
                                    }
                                    <button class="model-visibility-btn @(model.IsHidden ? "hidden" : "")"
                                            title="@(model.IsHidden ? "Show in model dropdowns" : "Hide from model dropdowns")"
                                            @onclick="() => OpenAiModelService.ToggleHidden(capturedId)">
                                        <span class="icon @(model.IsHidden ? "icon-eye-off" : "icon-eye")" style="width:14px;height:14px;"></span>
                                    </button>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </section>
    }

    @if (_activeTab == SettingsTab.SourceControl)
    {
    <section class="settings-section">
        <p class="section-title">GitHub (Pull Requests)</p>
        <div class="setting-card">
            <div class="setting-row">
                <div>
                    <p class="setting-label">OAuth App Client ID <span style="font-weight:400;color:var(--fg-secondary)">(optional override)</span></p>
                    <p class="setting-desc">
                        Sign-in works out of the box using DiffThis's own GitHub OAuth App. If you'd
                        rather DiffThis show up under a different app's name on your GitHub account,
                        <a href="https://github.com/settings/applications/new" target="_blank">create your own OAuth App ↗</a>
                        (enable "Device Flow") and paste its Client ID below (no client secret needed).
                    </p>
                </div>
            </div>
            <div class="setting-row">
                <input type="text" class="setting-text-input" placeholder="Iv1.xxxxxxxxxxxxxxxx (leave blank to use the default)"
                       value="@Svc.GitHubOAuthClientId"
                       @onchange="e => Svc.GitHubOAuthClientId = e.Value?.ToString() ?? string.Empty" />
            </div>
            <hr class="setting-card-divider" />
            <div class="setting-row">
                <div>
                    <p class="setting-label">Account</p>
                    @if (GitHubAuth.State == GitHubAuthState.Authenticated)
                    {
                        <p class="setting-desc">
                            <span class="auth-dot auth-ok"></span>
                            Connected
                            @if (!string.IsNullOrEmpty(GitHubAuth.Username))
                            {
                                <span> · @GitHubAuth.Username</span>
                            }
                        </p>
                    }
                    else if (GitHubAuth.State == GitHubAuthState.PendingDeviceFlow
                             && _gitHubDeviceFlowInfo is not null)
                    {
                        <p class="setting-desc"><span class="auth-dot auth-pending"></span>Waiting for authorization…</p>
                        <div class="device-flow-card">
                            <p class="device-flow-label">Enter this code at <strong>github.com/login/device</strong></p>
                            <div class="device-flow-code-row">
                                <code class="device-flow-code">@_gitHubDeviceFlowInfo.UserCode</code>
                                <a class="btn btn-sm" href="@_gitHubDeviceFlowInfo.VerificationUri" target="_blank">Open GitHub ↗</a>
                            </div>
                        </div>
                    }
                    else
                    {
                        <p class="setting-desc">
                            <span class="auth-dot auth-off"></span>
                            Not connected — click <strong>Sign in</strong> to authorize DiffThis to read your pull requests.
                        </p>
                        @if (!string.IsNullOrEmpty(GitHubAuth.LastError))
                        {
                            <p class="setting-desc" style="color:var(--del-fg);margin-top:4px;word-break:break-word">@GitHubAuth.LastError</p>
                        }
                    }
                </div>
                <div style="display:flex;flex-direction:column;gap:6px;align-items:flex-end">
                    @if (GitHubAuth.State == GitHubAuthState.Authenticated)
                    {
                        <button class="btn btn-sm btn-danger" @onclick="GitHubSignOut">Sign out</button>
                    }
                    else if (GitHubAuth.State == GitHubAuthState.PendingDeviceFlow)
                    {
                        <button class="btn btn-sm" @onclick="CancelGitHubSignIn">Cancel</button>
                    }
                    else
                    {
                        <button class="btn btn-sm" disabled="@_gitHubSigningIn" @onclick="StartGitHubSignIn">
                            @(_gitHubSigningIn ? "Starting…" : "Sign in")
                        </button>
                    }
                </div>
            </div>
        </div>
    </section>

    <section class="settings-section">
        <p class="section-title">GitLab (Pull Requests)</p>
        <div class="setting-card">
            <div class="setting-row">
                <div>
                    <p class="setting-label">Application ID <span style="font-weight:400;color:var(--fg-secondary)">(optional override)</span></p>
                    <p class="setting-desc">
                        Sign-in works out of the box using DiffThis's own GitLab Application. If you'd
                        rather DiffThis show up under a different application's name on your GitLab
                        account, <a href="https://gitlab.com/-/user_settings/applications" target="_blank">create your own ↗</a>
                        (scope: <code>read_api</code>, with "Device authorization grant" enabled and
                        "Confidential" unchecked) and paste its Application ID below.
                    </p>
                </div>
            </div>
            <div class="setting-row">
                <input type="text" class="setting-text-input" placeholder="Application ID (leave blank to use the default)"
                       value="@Svc.GitLabOAuthClientId"
                       @onchange="e => Svc.GitLabOAuthClientId = e.Value?.ToString() ?? string.Empty" />
            </div>
            <hr class="setting-card-divider" />
            <div class="setting-row">
                <div>
                    <p class="setting-label">Account</p>
                    @if (GitLabAuth.State == GitLabAuthState.Authenticated)
                    {
                        <p class="setting-desc">
                            <span class="auth-dot auth-ok"></span>
                            Connected
                            @if (!string.IsNullOrEmpty(GitLabAuth.Username))
                            {
                                <span> · @GitLabAuth.Username</span>
                            }
                        </p>
                    }
                    else if (GitLabAuth.State == GitLabAuthState.PendingDeviceFlow
                             && _gitLabDeviceFlowInfo is not null)
                    {
                        <p class="setting-desc"><span class="auth-dot auth-pending"></span>Waiting for authorization…</p>
                        <div class="device-flow-card">
                            <p class="device-flow-label">Enter this code at <strong>gitlab.com/login/device</strong></p>
                            <div class="device-flow-code-row">
                                <code class="device-flow-code">@_gitLabDeviceFlowInfo.UserCode</code>
                                <a class="btn btn-sm" href="@_gitLabDeviceFlowInfo.VerificationUri" target="_blank">Open GitLab ↗</a>
                            </div>
                        </div>
                    }
                    else
                    {
                        <p class="setting-desc">
                            <span class="auth-dot auth-off"></span>
                            Not connected — click <strong>Sign in</strong> to authorize DiffThis to read your merge requests.
                        </p>
                        @if (!string.IsNullOrEmpty(GitLabAuth.LastError))
                        {
                            <p class="setting-desc" style="color:var(--del-fg);margin-top:4px;word-break:break-word">@GitLabAuth.LastError</p>
                        }
                    }
                </div>
                <div style="display:flex;flex-direction:column;gap:6px;align-items:flex-end">
                    @if (GitLabAuth.State == GitLabAuthState.Authenticated)
                    {
                        <button class="btn btn-sm btn-danger" @onclick="GitLabSignOut">Sign out</button>
                    }
                    else if (GitLabAuth.State == GitLabAuthState.PendingDeviceFlow)
                    {
                        <button class="btn btn-sm" @onclick="CancelGitLabSignIn">Cancel</button>
                    }
                    else
                    {
                        <button class="btn btn-sm" disabled="@_gitLabSigningIn" @onclick="StartGitLabSignIn">
                            @(_gitLabSigningIn ? "Starting…" : "Sign in")
                        </button>
                    }
                </div>
            </div>
        </div>
    </section>

    <section class="settings-section">
        <p class="section-title">Bitbucket (Pull Requests)</p>
        <div class="setting-card">
            <div class="setting-row">
                <div>
                    <p class="setting-label">OAuth Client <span style="font-weight:400;color:var(--fg-secondary)">(optional override)</span></p>
                    <p class="setting-desc">
                        Browser sign-in works out of the box using DiffThis's own Bitbucket OAuth client. To use
                        your own instead, in your Bitbucket workspace's settings under "Apps and features" → OAuth
                        clients → Create OAuth client: name it anything, under Authorization check "Authorization
                        code" with callback URL <code>http://localhost:51738/callback</code>, and under Scopes
                        check "Repositories: Read" and "Pull requests: Read". Then paste its Client ID and Secret below.
                    </p>
                </div>
            </div>
            <div class="setting-row" style="gap:8px">
                <input type="text" class="setting-text-input" placeholder="Client ID (leave blank to use the default)" style="margin-top:0"
                       value="@Svc.BitbucketOAuthClientId"
                       @onchange="e => Svc.BitbucketOAuthClientId = e.Value?.ToString() ?? string.Empty" />
                <input type="password" class="setting-text-input" placeholder="Secret (leave blank to use the default)" style="margin-top:0"
                       value="@Svc.BitbucketOAuthClientSecret"
                       @onchange="e => Svc.BitbucketOAuthClientSecret = e.Value?.ToString() ?? string.Empty" />
            </div>
            <hr class="setting-card-divider" />
            <div class="setting-row">
                <div>
                    <p class="setting-label">Account</p>
                    @if (BitbucketAuth.State == BitbucketAuthState.Authenticated)
                    {
                        <p class="setting-desc">
                            <span class="auth-dot auth-ok"></span>
                            Connected
                            @if (!string.IsNullOrEmpty(BitbucketAuth.Username))
                            {
                                <span> · @BitbucketAuth.Username</span>
                            }
                        </p>
                    }
                    else
                    {
                        <p class="setting-desc">
                            <span class="auth-dot auth-off"></span>
                            Not connected — sign in with a browser, or use an API token (App Passwords are retired).
                        </p>
                        @if (!string.IsNullOrEmpty(BitbucketAuth.LastError))
                        {
                            <p class="setting-desc" style="color:var(--del-fg);margin-top:4px;word-break:break-word">@BitbucketAuth.LastError</p>
                        }
                    }
                </div>
                @if (BitbucketAuth.State == BitbucketAuthState.Authenticated)
                {
                    <button class="btn btn-sm btn-danger" @onclick="BitbucketSignOut">Sign out</button>
                }
                else
                {
                    <button class="btn btn-sm" disabled="@_bitbucketOAuthSigningIn" @onclick="StartBitbucketBrowserSignIn" style="flex-shrink:0">
                        @(_bitbucketOAuthSigningIn ? "Waiting for browser…" : "Sign in with browser")
                    </button>
                }
            </div>
            @if (BitbucketAuth.State != BitbucketAuthState.Authenticated)
            {
                <div class="setting-row" style="margin-top:10px;gap:8px">
                    <input type="text" class="setting-text-input" placeholder="Atlassian account email" style="margin-top:0"
                           @bind="_bitbucketUsername" />
                    <input type="password" class="setting-text-input" placeholder="API token" style="margin-top:0"
                           @bind="_bitbucketAppPassword" />
                    <button class="btn btn-sm" disabled="@_bitbucketSigningIn" @onclick="StartBitbucketSignIn" style="flex-shrink:0">
                        @(_bitbucketSigningIn ? "Connecting…" : "Connect")
                    </button>
                </div>
            }
        </div>
    </section>

    <section class="settings-section">
        <p class="section-title">Azure DevOps (Pull Requests)</p>
        <div class="setting-card">
            <div class="setting-row">
                <div>
                    <p class="setting-label">Microsoft Entra App <span style="font-weight:400;color:var(--fg-secondary)">(optional override)</span></p>
                    <p class="setting-desc">
                        Browser sign-in works out of the box using DiffThis's own Entra app registration. To use
                        your own, register one in the
                        <a href="https://entra.microsoft.com/#view/Microsoft_AAD_RegisteredApps/ApplicationsListBlade" target="_blank">Entra admin center ↗</a>
                        (platform "Mobile and desktop applications", redirect URI <code>http://localhost</code>,
                        "Allow public client flows" enabled, with Azure DevOps' <code>user_impersonation</code>
                        delegated permission), then paste its Application (client) ID below. Only works for
                        organizations backed by a Microsoft Entra (work/school) account, not a personal Microsoft account.
                    </p>
                </div>
            </div>
            <div class="setting-row">
                <input type="text" class="setting-text-input" placeholder="Application (client) ID (leave blank to use the default)"
                       value="@Svc.AzureDevOpsOAuthClientId"
                       @onchange="e => Svc.AzureDevOpsOAuthClientId = e.Value?.ToString() ?? string.Empty" />
            </div>
            <hr class="setting-card-divider" />
            <div class="setting-row">
                <div>
                    <p class="setting-label">Account</p>
                    @if (AzureDevOpsAuth.State == AzureDevOpsAuthState.Authenticated)
                    {
                        <p class="setting-desc">
                            <span class="auth-dot auth-ok"></span>
                            Connected
                            @if (!string.IsNullOrEmpty(AzureDevOpsAuth.Username))
                            {
                                <span> · @AzureDevOpsAuth.Username</span>
                            }
                        </p>
                    }
                    else
                    {
                        <p class="setting-desc">
                            <span class="auth-dot auth-off"></span>
                            Not connected — sign in with a browser, or use a Personal Access Token.
                        </p>
                        @if (!string.IsNullOrEmpty(AzureDevOpsAuth.LastError))
                        {
                            <p class="setting-desc" style="color:var(--del-fg);margin-top:4px;word-break:break-word">@AzureDevOpsAuth.LastError</p>
                        }
                    }
                </div>
                @if (AzureDevOpsAuth.State == AzureDevOpsAuthState.Authenticated)
                {
                    <button class="btn btn-sm btn-danger" @onclick="AzureDevOpsSignOut">Sign out</button>
                }
                else
                {
                    <button class="btn btn-sm" disabled="@_azureDevOpsOAuthSigningIn" @onclick="StartAzureDevOpsBrowserSignIn" style="flex-shrink:0">
                        @(_azureDevOpsOAuthSigningIn ? "Waiting for browser…" : "Sign in with browser")
                    </button>
                }
            </div>
            @if (AzureDevOpsAuth.State != AzureDevOpsAuthState.Authenticated)
            {
                <div class="setting-row" style="margin-top:10px;gap:8px">
                    <input type="password" class="setting-text-input" placeholder="Personal Access Token" style="margin-top:0"
                           @bind="_azureDevOpsPat" />
                    <button class="btn btn-sm" disabled="@_azureDevOpsSigningIn" @onclick="StartAzureDevOpsSignIn" style="flex-shrink:0">
                        @(_azureDevOpsSigningIn ? "Connecting…" : "Connect")
                    </button>
                </div>
            }
        </div>
    </section>

    <section class="settings-section">
        <p class="section-title">Git Hosts (Self-Hosted Pull Requests)</p>
        <p class="setting-desc" style="margin-bottom:10px">
            For self-hosted GitHub Enterprise, GitLab, Bitbucket Server/Data Center, or Gitea —
            matched by hostname against each repository's "origin" remote. Authenticated with a
            Personal Access Token from that instance.
        </p>
        @foreach (var host in GitHosts.Hosts)
        {
            var hostId = host.Id;
            <div class="setting-card">
                <div class="setting-row" style="gap:8px">
                    <input class="model-name-input" style="width:140px;text-align:left" placeholder="Name"
                           value="@host.Name" @onchange="e => UpdateGitHostName(hostId, e.Value?.ToString() ?? host.Name)" />
                    <input class="model-name-input" style="flex:1;text-align:left" placeholder="git.example.com"
                           value="@host.Host" @onchange="e => UpdateGitHostHost(hostId, e.Value?.ToString() ?? host.Host)" />
                    <select class="model-effort-select" @onchange="e => UpdateGitHostKind(hostId, e.Value?.ToString())">
                        @foreach (var kind in SelfHostedProviderKinds)
                        {
                            <option value="@kind" selected="@(host.Kind == kind)">@kind.DisplayName()</option>
                        }
                    </select>
                    <button class="btn btn-sm btn-danger" title="Remove host" @onclick="() => GitHosts.RemoveHost(hostId)">Remove</button>
                </div>
                <div class="setting-row" style="margin-top:8px;gap:8px">
                    <input type="password" class="model-name-input" style="flex:1;text-align:left"
                           placeholder="Personal Access Token"
                           value="@_gitHostTokenInputs.GetValueOrDefault(hostId, "")"
                           @onchange="e => SetGitHostTokenInput(hostId, e.Value?.ToString())" />
                    <button class="btn btn-sm" @onclick="() => SaveGitHostToken(hostId)">Save token</button>
                    @if (_gitHostSavedId == hostId)
                    {
                        <span class="setting-desc" style="margin:0">Saved</span>
                    }
                </div>
            </div>
        }
        <div class="setting-card">
            <button class="btn btn-sm" @onclick="AddGitHost">+ Add Git Host</button>
        </div>
    </section>
    }

    @if (_activeTab == SettingsTab.AiIntegration)
    {
    <section class="settings-section">
        <p class="section-title"><span class="icon icon-copilot" style="width:2em;height:2em;vertical-align:-0.4em;margin-right:0.35em;color:#8534F3"></span>GitHub Copilot</p>
        <div class="setting-card">
            <div class="setting-row">
                <div>
                    <p class="setting-label">Account</p>
                    @if (CopilotAuth.State == CopilotAuthState.Authenticated)
                    {
                        <p class="setting-desc">
                            <span class="auth-dot auth-ok"></span>
                            Connected
                            @if (!string.IsNullOrEmpty(CopilotAuth.Username))
                            {
                                <span> · @CopilotAuth.Username</span>
                            }
                        </p>
                    }
                    else if (CopilotAuth.State == CopilotAuthState.PendingDeviceFlow
                             && _deviceFlowInfo is not null)
                    {
                        <p class="setting-desc"><span class="auth-dot auth-pending"></span>Waiting for authorization…</p>
                        <div class="device-flow-card">
                            <p class="device-flow-label">Enter this code at <strong>github.com/login/device</strong></p>
                            <div class="device-flow-code-row">
                                <code class="device-flow-code">@_deviceFlowInfo.UserCode</code>
                                <a class="btn btn-sm" href="@_deviceFlowInfo.VerificationUri" target="_blank">Open GitHub ↗</a>
                            </div>
                        </div>
                    }
                    else
                    {
                        <p class="setting-desc">
                            <span class="auth-dot auth-off"></span>
                            Not connected — click <strong>Sign in</strong> to authorize DiffThis with your GitHub Copilot account.
                        </p>
                        @if (!string.IsNullOrEmpty(CopilotAuth.LastError))
                        {
                            <p class="setting-desc" style="color:var(--del-fg);margin-top:4px;word-break:break-word">@CopilotAuth.LastError</p>
                        }
                    }
                </div>
                <div style="display:flex;flex-direction:column;gap:6px;align-items:flex-end">
                    @if (CopilotAuth.State == CopilotAuthState.Authenticated)
                    {
                        <button class="btn btn-sm btn-danger" @onclick="CopilotSignOut">Sign out</button>
                    }
                    else if (CopilotAuth.State == CopilotAuthState.PendingDeviceFlow)
                    {
                        <button class="btn btn-sm" @onclick="CancelCopilotSignIn">Cancel</button>
                    }
                    else
                    {
                        <button class="btn btn-sm" disabled="@_copilotSigningIn" @onclick="StartCopilotSignIn">
                            @(_copilotSigningIn ? "Starting…" : "Sign in")
                        </button>
                    }
                </div>
            </div>
            <hr class="setting-card-divider" />
            <div class="setting-row">
                <div>
                    <button class="collapsible-label" @onclick="() => _copilotModelsExpanded = !_copilotModelsExpanded">
                        <span class="collapsible-chevron @(_copilotModelsExpanded ? "open" : "")">›</span>
                        <p class="setting-label" style="display:inline">Available models</p>
                    </button>
                    <p class="setting-desc">
                        @if (CopilotModelService.LastFetchedAt.HasValue)
                        {
                            <span>@CopilotModelService.Models.Count model@(CopilotModelService.Models.Count == 1 ? "" : "s") · last updated @CopilotModelService.LastFetchedAt.Value.ToLocalTime().ToString("MMM d · h:mm tt")</span>
                            if (CopilotModelService.IsUsingDefaults)
                            {
                                <span class="auth-plan" title="API fetch failed; using built-in model list"> · built-in list</span>
                            }
                            else { <span class="auth-plan"> · from API</span> }
                        }
                        else { <span>Never fetched</span> }
                    </p>
                </div>
                <button class="btn btn-sm" disabled="@CopilotModelService.IsLoading" @onclick="RefreshCopilotModels">
                    @(CopilotModelService.IsLoading ? "Refreshing…" : "Refresh")
                </button>
            </div>
            @if (_copilotModelsExpanded && CopilotModelService.Models.Count > 0)
            {
                <div class="model-list">
                    @foreach (var model in CopilotModelService.Models)
                    {
                        var capturedId = model.Id;
                        <div class="model-list-item @(model.IsHidden ? "model-hidden" : "")">
                            <div class="model-list-main-row">
                                <div class="model-list-meta"><code class="model-list-id">@model.Id</code></div>
                                <div class="model-list-name-row">
                                    @if (model.ReasoningEfforts.Length > 0)
                                    {
                                        <span class="model-effort-label" title="Controls how much of the output token budget the model spends on internal reasoning. Lower = more tokens for response text.">Effort</span>
                                        <select class="model-effort-select"
                                                value="@(model.ReasoningEffort ?? "low")"
                                                @onchange="e => CopilotModelService.SetReasoningEffort(capturedId, e.Value?.ToString())">
                                            @foreach (var effort in model.ReasoningEfforts)
                                            {
                                                <option value="@effort">@(char.ToUpper(effort[0]) + effort[1..])</option>
                                            }
                                        </select>
                                    }
                                    <input class="model-name-input" value="@model.DisplayName"
                                           @onchange="e => CopilotModelService.SetDisplayName(capturedId, e.Value?.ToString() ?? model.DisplayName)"
                                           title="Edit display name" />
                                    @if (model.IsCustomName)
                                    {
                                        <button class="model-reset-btn" title="Reset to default name"
                                                @onclick="() => CopilotModelService.ResetDisplayName(capturedId)">↺</button>
                                    }
                                    <button class="model-visibility-btn @(model.IsHidden ? "hidden" : "")"
                                            title="@(model.IsHidden ? "Show in model dropdowns" : "Hide from model dropdowns")"
                                            @onclick="() => CopilotModelService.ToggleHidden(capturedId)">
                                        <span class="icon @(model.IsHidden ? "icon-eye-off" : "icon-eye")" style="width:14px;height:14px;"></span>
                                    </button>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            <div class="setting-row" style="margin-top:8px">
                <label class="setting-label">Request timeout</label>
                <input type="number" class="setting-input setting-input-sm" min="10" style="width:80px"
                       value="@(Svc.CopilotTimeoutSeconds?.ToString() ?? "")"
                       placeholder="300"
                       title="Request timeout in seconds. Leave blank for no timeout."
                       @onchange="e => UpdateCopilotTimeout(e.Value?.ToString())" />
                <span class="setting-desc" style="margin:0">s timeout (blank = none)</span>
            </div>
        </div>
    </section>

    <section class="settings-section">
        <p class="section-title"><span class="icon icon-ollama" style="width:2em;height:2em;vertical-align:-0.4em;margin-right:0.35em;color:#D68E42"></span>Ollama</p>

        @foreach (var ep in OllamaEndpoints.Endpoints)
        {
            var epId   = ep.Id;
            var models = OllamaEndpoints.GetAllModels(epId);
            OllamaEndpoints.Errors.TryGetValue(epId, out var epError);

            <div class="setting-card">
                <!-- Config row: icon + name + color + url + remove -->
                <div class="setting-row">
                    <button class="ollama-icon-btn" title="Change icon"
                            style="color:@ep.BadgeColor"
                            @onclick="() => OpenBadgePicker(epId)">
                        <span class="icon @OllamaIconCssClass(ep.IconId)" style="width:18px;height:18px"></span>
                    </button>
                    <input class="model-name-input" style="width:110px;font-weight:600;text-align:left"
                           value="@ep.Name" placeholder="Name"
                           @onchange="e => UpdateOllamaEndpointName(epId, e.Value?.ToString() ?? ep.Name)" />
                    <input type="color" value="@ep.BadgeColor"
                           style="width:32px;height:28px;padding:2px;border:1px solid var(--border);border-radius:4px;cursor:pointer;background:transparent"
                           title="Badge colour"
                           @onchange="e => UpdateOllamaEndpointColor(epId, e.Value?.ToString() ?? ep.BadgeColor)" />
                    <input class="model-name-input" style="flex:1;min-width:0;text-align:left"
                           value="@ep.BaseUrl" placeholder="http://localhost:11434"
                           @onchange="e => UpdateOllamaEndpointUrl(epId, e.Value?.ToString() ?? ep.BaseUrl)" />
                    <button class="btn btn-sm btn-danger" title="Remove endpoint"
                            @onclick="() => OllamaEndpoints.RemoveEndpoint(epId)">Remove</button>
                </div>

                <!-- API key + timeout row -->
                <div style="margin-top:8px;display:flex;align-items:center;gap:10px;flex-wrap:wrap">
                    <input class="model-name-input" style="width:260px;text-align:left"
                           value="@(ep.ApiKey ?? "")" placeholder="API key (optional)"
                           type="password"
                           @onchange="e => UpdateOllamaEndpointApiKey(epId, e.Value?.ToString())" />
                    <input class="model-name-input" style="width:72px;text-align:right"
                           type="number" min="1"
                           value="@(ep.TimeoutSeconds?.ToString() ?? "")"
                           placeholder="∞"
                           title="Request timeout in seconds. Leave blank for no timeout."
                           @onchange="e => UpdateOllamaEndpointTimeout(epId, e.Value?.ToString())" />
                    <span class="setting-desc" style="margin:0">s timeout (blank = none)</span>
                </div>

                @if (epError is not null)
                {
                    <p class="setting-desc" style="margin-top:6px;color:var(--del-fg);word-break:break-word">@epError</p>
                }

                <!-- Available models (merged) -->
                <hr class="setting-card-divider" />
                <div class="setting-row">
                    <div>
                        <button class="collapsible-label" @onclick="() => ToggleOllamaModels(epId)">
                            <span class="collapsible-chevron @(_ollamaModelsExpanded.Contains(epId) ? "open" : "")">›</span>
                            <p class="setting-label" style="display:inline">Available models</p>
                        </button>
                        <p class="setting-desc">
                            @{ var realCount = models.Count(m => !m.IsPulling); var pullingCount = models.Count(m => m.IsPulling); }
                            @if (realCount > 0) { <span>@realCount model@(realCount == 1 ? "" : "s")</span> }
                            else if (epError is not null) { <span>Failed to fetch</span> }
                            else { <span>Never fetched</span> }
                            @if (pullingCount > 0) { <span> · @pullingCount pulling</span> }
                        </p>
                    </div>
                    <button class="btn btn-sm" disabled="@OllamaEndpoints.IsLoading"
                            @onclick="() => RefreshOllamaEndpoint(epId)">
                        @(OllamaEndpoints.IsLoading ? "Refreshing…" : "Refresh")
                    </button>
                </div>
                @if (_ollamaModelsExpanded.Contains(epId))
                {
                    <div class="model-list">
                        @foreach (var model in models)
                        {
                            var mid = model.Id;
                            @if (model.IsPulling)
                            {
                                var pullStatus = OllamaEndpoints.GetPullStatus(epId, mid) ?? "Starting…";
                                <div class="model-list-item">
                                    <div class="model-list-meta"><code class="model-list-id">@mid</code></div>
                                    <div class="model-list-name-row">
                                        <span class="model-name-input" style="flex:1;cursor:default;color:var(--fg-secondary)">@pullStatus</span>
                                        <span class="analysis-spinner" style="width:14px;height:14px;margin:0 2px;flex-shrink:0"></span>
                                        <button class="model-visibility-btn" title="Cancel pull"
                                                @onclick="() => OllamaEndpoints.CancelPull(epId, mid)">✕</button>
                                    </div>
                                </div>
                            }
                            else if (model.PullError is not null)
                            {
                                var capturedError = model.PullError;
                                <div class="model-list-item">
                                    <div class="model-list-meta"><code class="model-list-id" style="color:var(--del-fg)">@mid</code></div>
                                    <div class="model-list-name-row">
                                        <span class="model-name-input" style="flex:1;cursor:default;color:var(--del-fg)">Pull failed</span>
                                        <button class="model-visibility-btn" title="View error details"
                                                @onclick="() => ShowPullError(mid, capturedError)">ⓘ</button>
                                        <button class="model-visibility-btn" title="Clear"
                                                @onclick="() => OllamaEndpoints.ClearModelError(epId, mid)">✕</button>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <div class="model-list-item @(model.IsHidden ? "model-hidden" : "")">
                                    <div class="model-list-meta"><code class="model-list-id">@mid</code></div>
                                    <div class="model-list-name-row">
                                        <input class="model-name-input" value="@model.DisplayName"
                                               @onchange="e => OllamaEndpoints.SetModelDisplayName(epId, mid, e.Value?.ToString() ?? model.DisplayName)"
                                               title="Edit display name" />
                                        @if (model.IsCustomName)
                                        {
                                            <button class="model-reset-btn" title="Reset to default name"
                                                    @onclick="() => OllamaEndpoints.ResetModelDisplayName(epId, mid)">↺</button>
                                        }
                                        <button class="model-visibility-btn @(model.IsHidden ? "hidden" : "")"
                                                title="@(model.IsHidden ? "Show in model dropdowns" : "Hide from model dropdowns")"
                                                @onclick="() => OllamaEndpoints.ToggleModelHidden(epId, mid)">
                                            <span class="icon @(model.IsHidden ? "icon-eye-off" : "icon-eye")" style="width:14px;height:14px;"></span>
                                        </button>
                                    </div>
                                </div>
                            }
                        }
                        <!-- Pull a new model -->
                        @{ var pullInput = _pullInputs.GetValueOrDefault(epId, ""); }
                        <div class="model-list-item" style="gap:6px;background:none;border:none;padding:6px 0 2px">
                            <input class="model-name-input" style="flex:1;text-align:left" placeholder="Model name (e.g. llama3.2)"
                                   value="@pullInput"
                                   @oninput="e => SetPullInput(epId, e.Value?.ToString())"
                                   @onkeydown="e => OnPullKeyDown(e, epId)" />
                            <button class="btn btn-sm" disabled="@string.IsNullOrWhiteSpace(pullInput)"
                                    @onclick="() => StartPull(epId)">Pull</button>
                        </div>
                    </div>
                }
            </div>
        }

        @if (!OllamaEndpoints.Endpoints.Any())
        {
            <p class="setting-desc">No endpoints configured.</p>
        }

        <div class="setting-card" style="padding:10px 14px">
            <button class="btn btn-sm" @onclick="AddOllamaEndpoint">+ Add Endpoint</button>
        </div>
    </section>
    }

    @if (_activeTab == SettingsTab.General)
    {
    <section class="settings-section">
        <p class="section-title">Diff</p>
        <div class="setting-card">
            <div class="setting-row">
                <div>
                    <p class="setting-label">Context lines</p>
                    <p class="setting-desc">Lines of surrounding context shown per changed hunk. More context gives the AI more to work with for code review, at the cost of longer diffs. Changing this setting will require a fresh AI run — existing cached results use the context depth they were generated with.</p>
                </div>
                <select class="select-sm" @bind="diffContextLines" @bind:after="SaveDiffContextLines">
                    <option value="3">3 — minimal</option>
                    <option value="10">10 — standard</option>
                    <option value="25">25 — extended</option>
                    <option value="50">50 — full</option>
                </select>
            </div>
        </div>
    </section>

    <section class="settings-section">
        <p class="section-title">Unsupported Features</p>
        <div class="setting-card">
            <div class="setting-row">
                <div>
                    <p class="setting-label">Analysis cross-links</p>
                    <p class="setting-desc">Show clickable file references in analysis results, and display comment indicators in the diff panel at referenced lines. This feature is experimental and may not work correctly.</p>
                </div>
                <label class="toggle">
                    <input type="checkbox" @bind="analysisLinksEnabled" @bind:after="SaveAnalysisLinks" />
                    <span class="toggle-track"></span>
                </label>
            </div>
        </div>
    </section>

    <section class="settings-section">
        <p class="section-title">Logging</p>
        <div class="setting-card">
            <div class="setting-row">
                <div>
                    <p class="setting-label">AI request logging</p>
                    <p class="setting-desc">Write request parameters and raw API responses to daily log files. Useful for diagnosing provider errors.</p>
                </div>
                <label class="toggle">
                    <input type="checkbox" @bind="aiLoggingEnabled" @bind:after="SaveAiLogging" />
                    <span class="toggle-track"></span>
                </label>
            </div>
            @if (aiLoggingEnabled)
            {
                <hr class="setting-card-divider" />
                <div class="setting-row">
                    <p class="setting-desc" style="margin:0">
                        @if (LogSvc.LogFileCount == 0)
                        {
                            <span>No log files.</span>
                        }
                        else
                        {
                            <span>@LogSvc.LogFileCount log file@(LogSvc.LogFileCount == 1 ? "" : "s") in <code>@LogSvc.LogsDirectory</code></span>
                        }
                    </p>
                    <div style="display:flex;gap:6px">
                        <button class="btn btn-sm" @onclick="OpenLogsFolder">Open folder</button>
                        <button class="btn btn-sm btn-danger" disabled="@(LogSvc.LogFileCount == 0)"
                                @onclick="() => _showClearLogsConfirm = true">Clear</button>
                    </div>
                </div>
            }
        </div>
    </section>

    <section class="settings-section">
        <p class="section-title">Data</p>
        <div class="setting-card">
            <div class="setting-row">
                <div>
                    <p class="setting-label">Recent history</p>
                    <p class="setting-desc">Recently viewed repositories are shown on the home screen</p>
                </div>
                <select class="select-sm" @bind="maxRecent" @bind:after="SaveMaxRecent">
                    @foreach (var n in new[] { 5, 10, 15, 20, 25, 50 })
                    {
                        <option value="@n">@n</option>
                    }
                </select>
                <button class="btn btn-sm btn-danger" disabled="@(!Svc.RecentRepositoryPaths.Any())"
                        @onclick="() => _showClearRepoHistoryConfirm = true">Clear</button>
            </div>
        </div>
        <div class="setting-card">
            <div class="setting-row">
                <div>
                    <p class="setting-label">Cached results</p>
                    <p class="setting-desc">@(AiCache.Count == 0 ? "No cached results." : $"{AiCache.Count} cached result{(AiCache.Count == 1 ? "" : "s")} stored.")</p>
                </div>
                <button class="btn btn-sm btn-danger" disabled="@(AiCache.Count == 0)"
                        @onclick="() => _showClearCacheConfirm = true">Clear</button>
            </div>
        </div>
        <div class="setting-card">
            <div class="setting-row">
                <div>
                    <p class="setting-label">Diff state</p>
                    <p class="setting-desc">@(AiCache.VisibilityCount == 0 ? "No stored diff state." : $"Stored for {AiCache.VisibilityCount} diff{(AiCache.VisibilityCount == 1 ? "" : "s")}: hidden files, context line overrides, and hidden analysis cards.")</p>
                </div>
                <button class="btn btn-sm btn-danger" disabled="@(AiCache.VisibilityCount == 0)"
                        @onclick="() => _showClearVisibilityConfirm = true">Clear</button>
            </div>
        </div>
    </section>
    }

    @if (_showClearLogsConfirm)
    {
        <div class="modal-backdrop" @onclick="() => _showClearLogsConfirm = false">
            <div class="modal" @onclick:stopPropagation>
                <p class="modal-title">Clear log files?</p>
                <p class="modal-body">All @LogSvc.LogFileCount log file@(LogSvc.LogFileCount == 1 ? "" : "s") will be deleted. This cannot be undone.</p>
                <div class="modal-actions">
                    <button class="btn btn-sm" @onclick="() => _showClearLogsConfirm = false">Cancel</button>
                    <button class="btn btn-sm btn-danger" @onclick="ClearLogs">Yes, clear</button>
                </div>
            </div>
        </div>
    }

    @if (_showClearRepoHistoryConfirm)
    {
        <div class="modal-backdrop" @onclick="() => _showClearRepoHistoryConfirm = false">
            <div class="modal" @onclick:stopPropagation>
                <p class="modal-title">Clear recent history?</p>
                <p class="modal-body">All @Svc.RecentRepositoryPaths.Count recent repositor@(Svc.RecentRepositoryPaths.Count == 1 ? "y" : "ies") will be removed, along with their saved branch selections. This cannot be undone.</p>
                <div class="modal-actions">
                    <button class="btn btn-sm" @onclick="() => _showClearRepoHistoryConfirm = false">Cancel</button>
                    <button class="btn btn-sm btn-danger" @onclick="ClearRepoHistory">Yes, clear</button>
                </div>
            </div>
        </div>
    }

    @if (_showClearVisibilityConfirm)
    {
        <div class="modal-backdrop" @onclick="() => _showClearVisibilityConfirm = false">
            <div class="modal" @onclick:stopPropagation>
                <p class="modal-title">Clear diff state?</p>
                <p class="modal-body">Stored state for @AiCache.VisibilityCount diff@(AiCache.VisibilityCount == 1 ? "" : "s") will be deleted — hidden files, context line overrides, and hidden analysis cards. This cannot be undone.</p>
                <div class="modal-actions">
                    <button class="btn btn-sm" @onclick="() => _showClearVisibilityConfirm = false">Cancel</button>
                    <button class="btn btn-sm btn-danger" @onclick="ClearDiffState">Yes, clear</button>
                </div>
            </div>
        </div>
    }

    @if (_showClearCacheConfirm)
    {
        <div class="modal-backdrop" @onclick="() => _showClearCacheConfirm = false">
            <div class="modal" @onclick:stopPropagation>
                <p class="modal-title">Clear cached results?</p>
                <p class="modal-body">All @AiCache.Count stored AI response@(AiCache.Count == 1 ? "" : "s") will be deleted. This cannot be undone.</p>
                <div class="modal-actions">
                    <button class="btn btn-sm" @onclick="() => _showClearCacheConfirm = false">Cancel</button>
                    <button class="btn btn-sm btn-danger" @onclick="ClearAiCache">Yes, clear</button>
                </div>
            </div>
        </div>
    }

    @if (_activeTab == SettingsTab.General)
    {
    <section class="settings-section">
        <p class="section-title">About</p>
        <div class="setting-card">
            <div class="setting-row">
                <div>
                    <p class="setting-label">DiffThis</p>
                    <p class="setting-desc">Git branch diff viewer</p>
                    <p><a class="setting-desc" href="https://github.com/matt-dx/diffthis" target="_blank">github.com/matt-dx/diffthis</a></p>
                </div>
                <code class="version-badge">@(System.Reflection.Assembly.GetEntryAssembly()?.GetName().Version?.ToString(3) ?? "unknown")</code>
            </div>
        </div>
    </section>
    }

</div><!-- .page.narrow -->
</div><!-- .settings-body -->
</div><!-- .settings-view -->

@if (_pullErrorModal is not null)
{
    <div class="modal-backdrop" @onclick="() => _pullErrorModal = null">
        <div class="modal" @onclick:stopPropagation>
            <p class="modal-title" style="color:var(--del-fg)">Pull failed — @_pullErrorModal.Value.ModelId</p>
            <p class="modal-body" style="word-break:break-word;white-space:pre-wrap">@_pullErrorModal.Value.Error</p>
            <div class="modal-actions">
                <button class="btn btn-sm" @onclick="() => _pullErrorModal = null">Close</button>
            </div>
        </div>
    </div>
}

@if (_badgePickerEndpointId is not null)
{
    var pickerEp = OllamaEndpoints.GetEndpoint(_badgePickerEndpointId);
    var filtered = string.IsNullOrWhiteSpace(_badgeSearch)
        ? OllamaBadgeIcons.All
        : OllamaBadgeIcons.All.Where(id => id.Contains(_badgeSearch.Trim(), StringComparison.OrdinalIgnoreCase)).ToArray();

    <div class="modal-backdrop" @onclick="CloseBadgePicker">
        <div class="badge-picker-modal" @onclick:stopPropagation>
            <div class="badge-picker-header">
                <p class="badge-picker-title">Choose Badge</p>
                <input class="badge-picker-search" type="search" placeholder="Search…"
                       @bind="_badgeSearch" @bind:event="oninput" />
                <button class="badge-picker-close" title="Close" @onclick="CloseBadgePicker">✕</button>
            </div>
            <span class="badge-picker-count">@filtered.Length icon@(filtered.Length == 1 ? "" : "s")</span>
            <div class="badge-picker-grid">
                @{ var epColor = pickerEp?.BadgeColor ?? "#888"; var currentId = pickerEp?.IconId ?? "ollama"; }
                <button class="badge-picker-btn @(currentId == "ollama" ? "selected" : "")"
                        title="Ollama" style="color:@epColor"
                        @onclick='() => SelectBadge("ollama")'>
                    <span class="icon icon-ollama" style="width:20px;height:20px"></span>
                </button>
                @foreach (var iconId in filtered)
                {
                    var capturedId = iconId;
                    <button class="badge-picker-btn @(currentId == capturedId ? "selected" : "")"
                            title="@capturedId" style="color:@epColor"
                            @onclick="() => SelectBadge(capturedId)">
                        <span class="icon gi-@capturedId" style="width:20px;height:20px"></span>
                    </button>
                }
            </div>
        </div>
    </div>
}

@code {
    [SupplyParameterFromQuery(Name = "from")]
    private string? ReturnUrl { get; set; }

    [SupplyParameterFromQuery(Name = "tab")]
    private string? TabParam { get; set; }

    private enum SettingsTab { General, AiIntegration, SourceControl }
    private SettingsTab _activeTab = SettingsTab.General;

    private string _returnUrl = "/";

    private int  maxRecent;
    private bool fontLigatures;
    private int  diffContextLines;
    private bool aiToolsEnabled;
    private int  aiMaxTurns;
    private bool analysisLinksEnabled;
    private bool aiLoggingEnabled;
    private bool           _showClearLogsConfirm;
    private bool           _showClearRepoHistoryConfirm;
    private bool           _showClearCacheConfirm;
    private bool           _showClearVisibilityConfirm;
    private bool           _modelsExpanded;
    private bool           _copilotModelsExpanded;
    private bool           _openAiModelsExpanded;
    private bool           _openAiBusy;
    private bool           _copilotSigningIn;
    private DeviceFlowInfo? _deviceFlowInfo;
    private bool           _gitHubSigningIn;
    private GitHubDeviceFlowInfo? _gitHubDeviceFlowInfo;
    private bool           _gitLabSigningIn;
    private GitLabDeviceFlowInfo? _gitLabDeviceFlowInfo;
    private bool           _bitbucketSigningIn;
    private bool           _bitbucketOAuthSigningIn;
    private string         _bitbucketUsername = "";
    private string         _bitbucketAppPassword = "";
    private bool           _azureDevOpsSigningIn;
    private bool           _azureDevOpsOAuthSigningIn;
    private string         _azureDevOpsPat = "";
    private readonly Dictionary<string, string> _gitHostTokenInputs = [];
    private string?        _gitHostSavedId;
    private static readonly GitProviderKind[] SelfHostedProviderKinds =
    [
        GitProviderKind.GitHubEnterprise,
        GitProviderKind.GitLabSelfManaged,
        GitProviderKind.BitbucketServer,
        GitProviderKind.Gitea,
    ];
    private readonly HashSet<string>        _ollamaModelsExpanded = [];
    private readonly Dictionary<string, string> _pullInputs       = [];
    private (string ModelId, string Error)?     _pullErrorModal;
    private string? _badgePickerEndpointId;
    private string  _badgeSearch = "";

    private static string OllamaIconCssClass(string iconId) =>
        iconId == "ollama" ? "icon-ollama" : $"gi-{iconId}";

    protected override void OnInitialized()
    {
        _returnUrl            = string.IsNullOrWhiteSpace(ReturnUrl) ? "/" : ReturnUrl;
        _activeTab            = TabParam?.ToLowerInvariant() switch
        {
            "ai" or "ai-integration" => SettingsTab.AiIntegration,
            "source-control" or "scm" => SettingsTab.SourceControl,
            _ => SettingsTab.General,
        };
        maxRecent             = Svc.MaxRecentRepositories;
        fontLigatures         = Svc.FontLigatures;
        diffContextLines      = Svc.DiffContextLines;
        aiToolsEnabled        = Svc.AiToolsEnabled;
        aiMaxTurns            = Svc.AiMaxTurns;
        analysisLinksEnabled  = Svc.AnalysisLinksEnabled;
        aiLoggingEnabled      = Svc.AiLoggingEnabled;

        ModelService.ModelsChanged        += OnModelsChanged;
        CopilotModelService.ModelsChanged += OnModelsChanged;
        OpenAiModelService.ModelsChanged  += OnModelsChanged;
        CopilotAuth.StateChanged          += OnCopilotStateChanged;
        OpenAiAuth.StateChanged           += OnOpenAiStateChanged;
        OllamaEndpoints.Changed           += OnOllamaChanged;
        GitHubAuth.StateChanged           += OnGitHubStateChanged;
        GitLabAuth.StateChanged           += OnGitLabStateChanged;
        BitbucketAuth.StateChanged        += OnBitbucketStateChanged;
        AzureDevOpsAuth.StateChanged      += OnAzureDevOpsStateChanged;
        GitHosts.Changed                  += OnGitHostsChanged;
    }

    private void OnModelsChanged()         => InvokeAsync(StateHasChanged);
    private void OnCopilotStateChanged()   => InvokeAsync(StateHasChanged);
    private void OnOpenAiStateChanged()    => InvokeAsync(StateHasChanged);
    private void OnOllamaChanged()         => InvokeAsync(StateHasChanged);
    private void OnGitHubStateChanged()    => InvokeAsync(StateHasChanged);
    private void OnGitLabStateChanged()    => InvokeAsync(StateHasChanged);
    private void OnBitbucketStateChanged() => InvokeAsync(StateHasChanged);
    private void OnAzureDevOpsStateChanged() => InvokeAsync(StateHasChanged);
    private void OnGitHostsChanged()       => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        ModelService.ModelsChanged        -= OnModelsChanged;
        CopilotModelService.ModelsChanged -= OnModelsChanged;
        OpenAiModelService.ModelsChanged  -= OnModelsChanged;
        CopilotAuth.StateChanged          -= OnCopilotStateChanged;
        OpenAiAuth.StateChanged           -= OnOpenAiStateChanged;
        OllamaEndpoints.Changed           -= OnOllamaChanged;
        GitHubAuth.StateChanged           -= OnGitHubStateChanged;
        GitLabAuth.StateChanged           -= OnGitLabStateChanged;
        BitbucketAuth.StateChanged        -= OnBitbucketStateChanged;
        AzureDevOpsAuth.StateChanged      -= OnAzureDevOpsStateChanged;
        GitHosts.Changed                  -= OnGitHostsChanged;
    }

    private void AddOllamaEndpoint() =>
        OllamaEndpoints.AddEndpoint("Local", "http://localhost:11434");

    private void ShowPullError(string modelId, string error) =>
        _pullErrorModal = (modelId, error);

    private void SetPullInput(string endpointId, string? value) =>
        _pullInputs[endpointId] = value ?? "";

    private void OnPullKeyDown(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e, string endpointId)
    {
        if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(_pullInputs.GetValueOrDefault(endpointId)))
            _ = StartPull(endpointId);
    }

    private async Task StartPull(string endpointId)
    {
        var modelId = _pullInputs.GetValueOrDefault(endpointId, "").Trim();
        if (string.IsNullOrEmpty(modelId)) return;
        _pullInputs[endpointId] = "";
        _ollamaModelsExpanded.Add(endpointId);
        await OllamaEndpoints.StartPullAsync(endpointId, modelId);
    }

    private async Task RefreshOllamaEndpoint(string endpointId) =>
        await OllamaEndpoints.RefreshModelsAsync(endpointId);

    private void ToggleOllamaModels(string endpointId)
    {
        if (!_ollamaModelsExpanded.Remove(endpointId))
            _ollamaModelsExpanded.Add(endpointId);
    }

    private void OpenBadgePicker(string endpointId)
    {
        _badgePickerEndpointId = endpointId;
        _badgeSearch = "";
    }

    private void CloseBadgePicker() => _badgePickerEndpointId = null;

    private void SelectBadge(string iconId)
    {
        if (_badgePickerEndpointId is null) return;
        var ep = OllamaEndpoints.GetEndpoint(_badgePickerEndpointId);
        if (ep is not null) OllamaEndpoints.UpdateEndpoint(ep with { IconId = iconId });
        _badgePickerEndpointId = null;
    }

    private void UpdateOllamaEndpointName(string id, string name)
    {
        var ep = OllamaEndpoints.GetEndpoint(id);
        if (ep is not null) OllamaEndpoints.UpdateEndpoint(ep with { Name = name });
    }

    private void UpdateOllamaEndpointUrl(string id, string url)
    {
        var ep = OllamaEndpoints.GetEndpoint(id);
        if (ep is not null) OllamaEndpoints.UpdateEndpoint(ep with { BaseUrl = url });
    }

    private void UpdateOllamaEndpointApiKey(string id, string? key)
    {
        var ep = OllamaEndpoints.GetEndpoint(id);
        if (ep is not null)
            OllamaEndpoints.UpdateEndpoint(ep with { ApiKey = string.IsNullOrEmpty(key) ? null : key });
    }

    private void UpdateOllamaEndpointColor(string id, string color)
    {
        var ep = OllamaEndpoints.GetEndpoint(id);
        if (ep is not null) OllamaEndpoints.UpdateEndpoint(ep with { BadgeColor = color });
    }

    private void UpdateOllamaEndpointTimeout(string id, string? value)
    {
        var ep = OllamaEndpoints.GetEndpoint(id);
        if (ep is null) return;
        var timeout = int.TryParse(value, out var secs) && secs > 0 ? secs : (int?)null;
        OllamaEndpoints.UpdateEndpoint(ep with { TimeoutSeconds = timeout });
    }

    private void UpdateCopilotTimeout(string? value)
    {
        var timeout = int.TryParse(value, out var secs) && secs > 0 ? secs : (int?)null;
        Svc.CopilotTimeoutSeconds = timeout;
    }

    private async Task RefreshModels()        => await ModelService.RefreshAsync();
    private async Task RefreshCopilotModels() => await CopilotModelService.RefreshAsync();
    private async Task RefreshOpenAiModels()  => await OpenAiModelService.RefreshAsync();

    private void SetTheme(AppTheme theme)
    {
        Svc.Theme = theme;
        StateHasChanged();
    }

    private void SaveMaxRecent() =>
        Svc.MaxRecentRepositories = maxRecent;

    private void SaveFontLigatures() =>
        Svc.FontLigatures = fontLigatures;

    private void SaveDiffContextLines() => Svc.DiffContextLines = diffContextLines;
    private void SaveAiTools()        => Svc.AiToolsEnabled      = aiToolsEnabled;
    private void SaveAiMaxTurns()     => Svc.AiMaxTurns           = aiMaxTurns;
    private void SaveAnalysisLinks()  => Svc.AnalysisLinksEnabled = analysisLinksEnabled;
    private void SaveAiLogging()      => Svc.AiLoggingEnabled     = aiLoggingEnabled;

    private void ClearLogs()
    {
        LogSvc.ClearLogs();
        _showClearLogsConfirm = false;
    }

    private void OpenLogsFolder() => LogSvc.OpenLogsFolder();

    private void ClearRepoHistory()
    {
        foreach (var path in Svc.RecentRepositoryPaths.ToList())
        {
            Svc.RemoveBranchState(path);
            Svc.RemoveRecentRepository(path);
        }
        _showClearRepoHistoryConfirm = false;
    }

    private void ClearAiCache()
    {
        AiCache.Clear();
        _showClearCacheConfirm = false;
    }

    private void ClearDiffState()
    {
        AiCache.ClearVisibility();
        _showClearVisibilityConfirm = false;
    }

    private async Task ReloadAuth()
    {
        await ClaudeAuth.RefreshAsync();
        StateHasChanged();
    }

    private async Task StartCopilotSignIn()
    {
        _copilotSigningIn = true;
        StateHasChanged();
        _deviceFlowInfo   = await CopilotAuth.StartDeviceFlowAsync();
        _copilotSigningIn = false;
        StateHasChanged();
    }

    private async Task StartOpenAiSignIn()
    {
        _openAiBusy = true;
        StateHasChanged();
        try
        {
            await OpenAiAuth.TryInteractiveLoginAsync();
            if (OpenAiAuth.State == OpenAiAuthState.Authenticated)
                await OpenAiModelService.RefreshAsync();
        }
        finally
        {
            _openAiBusy = false;
            StateHasChanged();
        }
    }

    private async Task RefreshOpenAiAuth()
    {
        _openAiBusy = true;
        try { await OpenAiAuth.RefreshAsync(); }
        finally
        {
            _openAiBusy = false;
            StateHasChanged();
        }
    }

    private async Task OpenAiSignOut()
    {
        _openAiBusy = true;
        try { await OpenAiAuth.SignOutAsync(); }
        finally
        {
            _openAiBusy = false;
            StateHasChanged();
        }
    }

    private void CancelCopilotSignIn()
    {
        _deviceFlowInfo = null;
        CopilotAuth.SignOut(); // resets state to NotFound and fires StateChanged
    }

    private void CopilotSignOut()
    {
        _deviceFlowInfo = null;
        CopilotAuth.SignOut();
    }

    private async Task StartGitHubSignIn()
    {
        _gitHubSigningIn      = true;
        StateHasChanged();
        _gitHubDeviceFlowInfo = await GitHubAuth.StartDeviceFlowAsync();
        _gitHubSigningIn      = false;
        StateHasChanged();
    }

    private void CancelGitHubSignIn()
    {
        _gitHubDeviceFlowInfo = null;
        GitHubAuth.SignOut(); // resets state to NotFound and fires StateChanged
    }

    private void GitHubSignOut()
    {
        _gitHubDeviceFlowInfo = null;
        GitHubAuth.SignOut();
    }

    private async Task StartGitLabSignIn()
    {
        _gitLabSigningIn      = true;
        StateHasChanged();
        _gitLabDeviceFlowInfo = await GitLabAuth.StartDeviceFlowAsync();
        _gitLabSigningIn      = false;
        StateHasChanged();
    }

    private void CancelGitLabSignIn()
    {
        _gitLabDeviceFlowInfo = null;
        GitLabAuth.SignOut();
    }

    private void GitLabSignOut()
    {
        _gitLabDeviceFlowInfo = null;
        GitLabAuth.SignOut();
    }

    private async Task StartBitbucketSignIn()
    {
        _bitbucketSigningIn = true;
        StateHasChanged();
        try { await BitbucketAuth.SignInAsync(_bitbucketUsername, _bitbucketAppPassword); }
        finally
        {
            _bitbucketAppPassword = "";
            _bitbucketSigningIn   = false;
            StateHasChanged();
        }
    }

    private void BitbucketSignOut()
    {
        _bitbucketUsername    = "";
        _bitbucketAppPassword = "";
        BitbucketAuth.SignOut();
    }

    private async Task StartBitbucketBrowserSignIn()
    {
        _bitbucketOAuthSigningIn = true;
        StateHasChanged();
        try { await BitbucketAuth.SignInWithBrowserAsync(); }
        finally
        {
            _bitbucketOAuthSigningIn = false;
            StateHasChanged();
        }
    }

    private async Task StartAzureDevOpsSignIn()
    {
        _azureDevOpsSigningIn = true;
        StateHasChanged();
        try { await AzureDevOpsAuth.SignInAsync(_azureDevOpsPat); }
        finally
        {
            _azureDevOpsPat       = "";
            _azureDevOpsSigningIn = false;
            StateHasChanged();
        }
    }

    private async Task StartAzureDevOpsBrowserSignIn()
    {
        _azureDevOpsOAuthSigningIn = true;
        StateHasChanged();
        try { await AzureDevOpsAuth.SignInWithBrowserAsync(); }
        finally
        {
            _azureDevOpsOAuthSigningIn = false;
            StateHasChanged();
        }
    }

    private void AzureDevOpsSignOut() => AzureDevOpsAuth.SignOut();

    private void AddGitHost() =>
        GitHosts.AddHost("New Host", "", GitProviderKind.Gitea);

    private void UpdateGitHostName(string id, string name)
    {
        var host = GitHosts.Hosts.FirstOrDefault(h => h.Id == id);
        if (host is null) return;
        GitHosts.UpdateHost(new GitHostConfig { Id = id, Name = name, Host = host.Host, Kind = host.Kind });
    }

    private void UpdateGitHostHost(string id, string hostname)
    {
        var host = GitHosts.Hosts.FirstOrDefault(h => h.Id == id);
        if (host is null) return;
        GitHosts.UpdateHost(new GitHostConfig { Id = id, Name = host.Name, Host = hostname, Kind = host.Kind });
    }

    private void UpdateGitHostKind(string id, string? kindValue)
    {
        var host = GitHosts.Hosts.FirstOrDefault(h => h.Id == id);
        if (host is null || !Enum.TryParse<GitProviderKind>(kindValue, out var kind)) return;
        GitHosts.UpdateHost(new GitHostConfig { Id = id, Name = host.Name, Host = host.Host, Kind = kind });
    }

    private void SetGitHostTokenInput(string id, string? value) =>
        _gitHostTokenInputs[id] = value ?? "";

    private async Task SaveGitHostToken(string id)
    {
        var token = _gitHostTokenInputs.GetValueOrDefault(id, "");
        if (string.IsNullOrWhiteSpace(token)) return;
        await GitHosts.SetTokenAsync(id, token);
        _gitHostTokenInputs.Remove(id);
        _gitHostSavedId = id;
        StateHasChanged();
    }

    private string Active(AppTheme t) => Svc.Theme == t ? "active" : "";
}
