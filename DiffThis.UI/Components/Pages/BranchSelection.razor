    private async Task SaveInlineSelfHostedToken()
    {
        if (_prProvider?.GitHostId is null || string.IsNullOrWhiteSpace(_selfHostedToken)) return;
        _selfHostedSavingToken = true;
        _selfHostedTokenError  = null;
        StateHasChanged();
        if (!await GitHosts.SetTokenAsync(_prProvider.GitHostId, _selfHostedToken.Trim()))
        {
            _selfHostedSavingToken = false;
            _selfHostedTokenError  = "Unable to securely store the token on this device.";
            StateHasChanged();
            return;
        }
        _selfHostedSavingToken = false;
        CloseSignInModal();
        await LoadPullRequestsAsync(prState);
    }

    private int _prLoadGeneration;

    // Open and Closed can both be mid-load at once (e.g. switching tabs quickly, or the upfront
    // ready-check kicking one off right as a tab switch starts another). They share prsLoading/
    // prError, so an older, slower request finishing after a newer one would otherwise stomp on
    // the current tab's spinner, replace its result with a stale error, or reopen sign-in for a
    // problem that's already resolved. A generation counter lets only the latest request win.
    private async Task LoadPullRequestsAsync(PullRequestState state)
    {
        if (string.IsNullOrEmpty(RepoPath)) return;
        var myGeneration = ++_prLoadGeneration;
        prsLoading = true;
        prError = "";
        StateHasChanged();
        try
        {
            var result = await PullRequests.GetPullRequestsAsync(RepoPath, state);
            if (myGeneration != _prLoadGeneration) return;
            if (state == PullRequestState.Open) openPrs = result; else closedPrs = result;
        }
        catch (Exception ex)
        {
            if (myGeneration != _prLoadGeneration) return;
            prError = ex.Message;
        }
        finally
        {
            if (myGeneration == _prLoadGeneration) prsLoading = false;
        }

        if (myGeneration != _prLoadGeneration) return;

        // An auth problem slipped through the upfront check (e.g. a token was revoked or a refresh
        // failed mid-session). _prProvider is already known at this point, so offer the same inline
        // sign-in (browser flow / device flow / token paste) used upfront, instead of bouncing the
        // user out to Settings.
        if (IsAuthError(prError))
        {
            ShowSignInModal(prError);
            prError = "";
        }

        await InvokeAsync(StateHasChanged);
    }

    private static bool IsAuthError(string message) =>
        message.Contains("Not signed in", StringComparison.OrdinalIgnoreCase) ||
        message.Contains("rejected the stored credentials", StringComparison.OrdinalIgnoreCase) ||
        message.Contains("No token saved", StringComparison.OrdinalIgnoreCase);

    /// Selecting a PR card launches its compare immediately — there's no separate "Compare" button
    /// to scroll down and click for pull requests.
    private async Task SelectAndComparePullRequest(PullRequestInfo pr)
    {
        if (comparing || RepoPath is null) return;
        selectedPr   = pr;
        compareError = "";
        comparing    = true;
        StateHasChanged();
        try
        {
            var localRef   = $"pr/{pr.Provider}/{pr.Number}";
            var resolution = await GitService.FetchPullRequestRefAsync(RepoPath, pr.SourceRemoteRef, localRef, pr.BaseRefName, pr.MergeCommitSha, pr.SourceRemoteUrl, pr.IsCrossRepository, pr.SourcePinnedCommit);
            var baseRef    = resolution.BaseRefOverride ?? resolution.MergeBase ?? $"origin/{pr.BaseRefName}";

            Session.CurrentDiff = await GitService.GetDiffAsync(RepoPath, baseRef, resolution.CompareRef, contextLines: Settings.DiffContextLines);
            Session.CurrentDiff.BaseLabel    = resolution.BaseRefOverride is not null ? $"{pr.BaseRefName} (pre-merge)"
                : resolution.MergeBase is not null ? $"{pr.BaseRefName} (PR base)"
                : pr.BaseRefName;
            Session.CurrentDiff.CompareLabel = resolution.BaseRefOverride is null
                ? $"PR #{pr.Number}: {pr.HeadRefName}"
                : $"PR #{pr.Number}: {pr.HeadRefName} (reconstructed from merge commit)";

            Nav.NavigateTo("/diff");
            return; // leave comparing=true so the clicked card stays "Computing diff…" until unmounted
        }
        catch (Exception ex) { compareError = ex.Message; }
        comparing = false;
    }

    private CancellationTokenSource? _copyToastCts;
    private CancellationTokenSource? _bbSignInCts;
    private CancellationTokenSource? _adoSignInCts;
    private string? _signInReopenError;

    private async Task CopyDeviceCode(string code)
    {
        await JS.InvokeVoidAsync("copyToClipboard", code);

        _copyToastCts?.Cancel();
        _copyToastCts = new CancellationTokenSource();
        var ct = _copyToastCts.Token;

        _codeCopied = true;
        StateHasChanged();
        try
        {
            await Task.Delay(1500, ct);
            _codeCopied = false;
            StateHasChanged();
        }
        catch (OperationCanceledException) { }
    }

    private async Task OnBaseBranchChanged()
    {
        baseCommit  = null;
        baseCommits = [];
        if (pinBase) await LoadBaseCommitsAsync();
    }

    private async Task OnCompareBranchChanged()
    {
        compareCommit  = null;
        compareCommits = [];
        if (pinCompare) await LoadCompareCommitsAsync();
    }

    private async Task OnPinBaseChanged()
    {
        if (pinBase && baseCommits.Count == 0)
            await LoadBaseCommitsAsync();
    }

    private async Task OnPinCompareChanged()
    {
        if (pinCompare && compareCommits.Count == 0)
            await LoadCompareCommitsAsync();
    }

    private async Task LoadBaseCommitsAsync()
    {
        if (string.IsNullOrEmpty(baseBranch) || string.IsNullOrEmpty(RepoPath)) return;
        baseCommitsLoading = true;
        StateHasChanged();
        try
        {
            baseCommits = await GitService.GetCommitsAsync(RepoPath, baseBranch);
            baseCommit  = baseCommits.FirstOrDefault()?.Hash;
        }
        finally { baseCommitsLoading = false; }
    }

    private async Task LoadCompareCommitsAsync()
    {
        if (string.IsNullOrEmpty(compareBranch) || string.IsNullOrEmpty(RepoPath)) return;
        compareCommitsLoading = true;
        StateHasChanged();
        try
        {
            compareCommits = await GitService.GetCommitsAsync(RepoPath, compareBranch);
            compareCommit  = compareCommits.FirstOrDefault()?.Hash;
        }
        finally { compareCommitsLoading = false; }
    }

    private void Swap()
    {
        (baseBranch,   compareBranch)   = (compareBranch,   baseBranch);
        (pinBase,      pinCompare)      = (pinCompare,      pinBase);
        (baseCommit,   compareCommit)   = (compareCommit,   baseCommit);
        (baseCommits,  compareCommits)  = (compareCommits,  baseCommits);
    }

    private async Task Compare()
    {
        if (!CanCompare || comparing || RepoPath is null) return;
        comparing    = true;
        compareError = "";
        try
        {
            var baseRef    = pinBase    && !string.IsNullOrEmpty(baseCommit)    ? baseCommit!    : baseBranch!;
            var compareRef = pinCompare && !string.IsNullOrEmpty(compareCommit) ? compareCommit! : compareBranch!;

            Session.CurrentDiff = await GitService.GetDiffAsync(RepoPath, baseRef, compareRef, contextLines: Settings.DiffContextLines);

            // Build display labels — show "branch @ shortHash" when a specific commit is pinned
            Session.CurrentDiff.BaseLabel = pinBase && !string.IsNullOrEmpty(baseCommit)
                ? $"{baseBranch} @ {(baseCommits.FirstOrDefault(c => c.Hash == baseCommit)?.ShortHash ?? baseCommit![..7])}"
                : baseBranch!;
            Session.CurrentDiff.CompareLabel = pinCompare && !string.IsNullOrEmpty(compareCommit)
                ? $"{compareBranch} @ {(compareCommits.FirstOrDefault(c => c.Hash == compareCommit)?.ShortHash ?? compareCommit![..7])}"
                : compareBranch!;

            Settings.SaveBranchState(RepoPath, new BranchSelectionState
            {
                BaseBranch    = baseBranch!,
                CompareBranch = compareBranch!,
                PinBase       = pinBase,
                PinCompare    = pinCompare,
                BaseCommit    = baseCommit    ?? string.Empty,
                CompareCommit = compareCommit ?? string.Empty
            });

            Nav.NavigateTo("/diff");
            return; // leave comparing=true so button stays "Computing diff…" until unmounted
        }
        catch (Exception ex) { compareError = ex.Message; }
        comparing = false;
    }
