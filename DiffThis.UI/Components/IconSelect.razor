@* Custom model selector with provider icon in trigger and each option. *@

<div class="model-dropdown">
    @if (_open)
    {
        <div class="model-dropdown-backdrop" @onclick="Close"></div>
    }
    <button class="model-dropdown-trigger" type="button" @onclick="Toggle" disabled="@(!Options.Any())">
        @if (!string.IsNullOrEmpty(Value))
        {
            var selectedModel = Options.FirstOrDefault(m => m.Key == Value);
            @if (selectedModel is not null)
            {
                <span class="icon @selectedModel.IconId" style="width:14px;height:14px;color:@selectedModel.BadgeColor"></span>
            }
        }
        <span class="model-dropdown-name">@(SelectedName ?? "—")</span>
        <span class="model-dropdown-chevron">▾</span>
    </button>
    @if (_open && Options.Any())
    {
        <div class="model-dropdown-menu">
            @foreach (var m in Options)
            {
                var captured = m;
                <button type="button"
                        class="model-dropdown-option @(m.Key == Value ? "selected" : "")"
                        @onclick="() => Select(captured)">
                    <span class="icon @m.IconId" style="width:14px;height:14px;color:@m.BadgeColor"></span>
                    <span class="model-dropdown-option-name">@m.DisplayName</span>
                </button>
            }
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired] public List<AiModel> Options { get; set; } = [];
    [Parameter] public string Value { get; set; } = "";
    [Parameter] public EventCallback<string> ValueChanged { get; set; }

    private bool _open;

    private string? SelectedName =>
        Options.FirstOrDefault(m => m.Key == Value)?.DisplayName;

    private void Toggle() => _open = !_open;
    private void Close()  => _open = false;

    private async Task Select(AiModel m)
    {
        _open = false;
        await ValueChanged.InvokeAsync(m.Key);
    }
}
